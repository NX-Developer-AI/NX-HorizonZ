+                                "x",
+                                Tag::Double(d::as_double(value.get("x"), 0.0).to_bits()),
+                            ),
+                            (
+                                "z",
+                                Tag::Double(d::as_double(value.get("z"), 0.0).to_bits()),
+                            ),
+                            (
+                                "rot",
+                                Tag::Double(d::as_double(value.get("rotation"), 0.0).to_bits()),
