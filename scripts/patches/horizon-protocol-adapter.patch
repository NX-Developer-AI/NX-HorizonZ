+                "frame",
+                "red_marker",
+                "blue_marker",
+                "target_x",
+                "target_point",
+                "player_off_map",
+                "player_off_limits",
+                "mansion",
+                "monument",
+                "banner_white",
+                "banner_orange",
+                "banner_magenta",
+                "banner_light_blue",
+                "banner_yellow",
+                "banner_lime",
+                "banner_pink",
+                "banner_gray",
+                "banner_light_gray",
+                "banner_cyan",
+                "banner_purple",
+                "banner_blue",
+                "banner_brown",
+                "banner_green",
+                "banner_red",
+                "banner_black",
+                "red_x",
+                "village_desert",
+                "village_plains",
+                "village_savanna",
+                "village_snowy",
+                "village_taiga",
+                "jungle_temple",
+                "swamp_hut",
