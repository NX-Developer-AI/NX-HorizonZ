+
+    fn encode<T: Codec<T>>(v: &T) -> Vec<u8> {
+        let mut w = Writer::new();
+        T::write(v, &mut w);
+        w.data
+    }
+
+    fn core(version: &str) -> KnownPack {
+        KnownPack {
+            namespace: "minecraft".into(),
+            id: "core".into(),
+            version: version.into(),
+        }
