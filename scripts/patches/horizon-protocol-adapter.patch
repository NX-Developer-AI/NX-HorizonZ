+pub fn clientbound(state: State) -> &'static [Option<u8>] {
+    match state {
+        State::Handshake => HANDSHAKE_CLIENTBOUND,
+        State::Status => STATUS_CLIENTBOUND,
+        State::Login => LOGIN_CLIENTBOUND,
+        State::Configuration => CONFIGURATION_CLIENTBOUND,
+        State::Play => PLAY_CLIENTBOUND,
+    }
+}
+/// For each pinned-version id Horizon sends in `state`, the id a 1.20.2 server knows it by.
+pub fn serverbound(state: State) -> &'static [Option<u8>] {
+    match state {
+        State::Handshake => HANDSHAKE_SERVERBOUND,
+        State::Status => STATUS_SERVERBOUND,
+        State::Login => LOGIN_SERVERBOUND,
+        State::Configuration => CONFIGURATION_SERVERBOUND,
+        State::Play => PLAY_SERVERBOUND,
+    }
+}
