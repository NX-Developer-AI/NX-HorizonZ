+use horizon_protocol::{
+    buf::{Codec, Ident, Reader, Str, Writer},
+    packets::{configuration, play},
+};
+
+fn wire(value: &str) -> Vec<u8> {
+    let mut writer = Writer::new();
+    writer.string(value);
+    writer.data
+}
+
+#[test]
+fn identifiers_normalize_default_namespace_without_restricting_empty_paths() {
+    for (input, expected) in [
+        ("stone", "minecraft:stone"),
+        (":stone", "minecraft:stone"),
+        ("", "minecraft:"),
+        (":", "minecraft:"),
+        ("mod:", "mod:"),
+        ("mod:dir/file.-_09", "mod:dir/file.-_09"),
+    ] {
+        let bytes = wire(input);
+        let mut reader = Reader::new(&bytes);
+        assert_eq!(Ident::read(&mut reader).unwrap(), expected, "{input:?}");
+        assert_eq!(reader.remaining(), 0);
+    }
+}
+
+#[test]
+fn identifier_validation_does_not_change_ordinary_packet_strings() {
+    for input in [
+        "STONE",
+        "mod:UPPER",
+        "a:b:c",
+        "a+b:c",
+        "a/b:c",
+        "a b:c",
+        "a:é",
+    ] {
+        let bytes = wire(input);
+        assert!(Ident::read(&mut Reader::new(&bytes)).is_err(), "{input:?}");
+        assert_eq!(Str::read(&mut Reader::new(&bytes)).unwrap(), input);
+    }
+}
+
+#[test]
+fn configuration_and_play_custom_payloads_share_identifier_decoding() {
+    let mut body = wire("request_secret");
+    body.extend_from_slice(&[0, 1, 255]);
+    let cfg = configuration::Clientbound::decode(
+        horizon_protocol::ids::configuration::clientbound::CUSTOM_PAYLOAD,
+        &body,
+    )
+    .unwrap();
+    let configuration::Clientbound::CustomPayload(payload) = cfg else {
+        panic!("wrong packet")
+    };
+    assert_eq!(payload.channel, "minecraft:request_secret");
+    assert_eq!(payload.data, [0, 1, 255]);
+    let packet = play::Clientbound::decode(
+        horizon_protocol::ids::play::clientbound::CUSTOM_PAYLOAD,
+        &body,
+    )
+    .unwrap();
+    let play::Clientbound::CustomPayload(payload) = packet else {
+        panic!("wrong packet")
+    };
+    assert_eq!(payload.channel, "minecraft:request_secret");
+    assert_eq!(payload.data, [0, 1, 255]);
+    let invalid = wire("bad:CHANNEL");
+    assert!(
+        configuration::Clientbound::decode(
+            horizon_protocol::ids::configuration::clientbound::CUSTOM_PAYLOAD,
+            &invalid
+        )
+        .is_err()
+    );
+    assert!(
+        play::Clientbound::decode(
+            horizon_protocol::ids::play::clientbound::CUSTOM_PAYLOAD,
+            &invalid
+        )
+        .is_err()
+    );
+}
diff --git a/crates/horizon-protocol/tests/retained_census.rs b/crates/horizon-protocol/tests/retained_census.rs
new file mode 100644
index 0000000000..121d92136a
--- /dev/null
+++ b/crates/horizon-protocol/tests/retained_census.rs
@@ -0,0 +1,177 @@
+//! A separate test binary owns this allocator. The unique tag isolates the
+//! retained values from the harness and the allocations made by census() itself.
+use horizon_world::nbt::{JavaString, Tag};
+use horizon_protocol::retained::OwnedHeap;
+use horizon_threads::{CensusAllocator, heap_census};
+use std::collections::BTreeMap;
+
+#[global_allocator]
+static ALLOCATOR: CensusAllocator = CensusAllocator;
+const TAG: &str = "protocol retained map census";
+
+fn live_bytes() -> usize {
+    let bytes = heap_census::census()
+        .into_iter()
+        .find_map(|(name, bytes)| (name == TAG).then_some(bytes))
+        .unwrap_or(0);
+    usize::try_from(bytes).expect("tag's live allocation count must not be negative")
+}
+
+fn assert_covers_live_layout<T: OwnedHeap>(case: &str, build: impl FnOnce() -> T) {
+    assert_covers_charge(case, build, OwnedHeap::owned_heap_bytes);
+}
+
+fn assert_covers_charge<T>(
+    case: &str,
+    build: impl FnOnce() -> T,
+    charge: impl FnOnce(&T) -> usize,
+) {
+    assert_eq!(live_bytes(), 0, "previous case leaked tagged storage");
+    let value = {
+        // Direct tag() is unconditional: the alloc-census feature is unnecessary
+        // when explicitly installing CensusAllocator instead of the game's allocator.
+        let _tag = heap_census::tag(TAG);
+        build()
+    };
+    // The tag guard is gone before census() allocates its own result vector.
+    // CensusAllocator records Layout::size(), excluding its own header and the
+    // backing allocator's metadata/rounding, exactly the accounting boundary here.
+    let observed = live_bytes();
+    let charged = charge(&value);
+    assert!(
+        observed > 0,
+        "{case}: census must observe real retained storage"
+    );
+    assert!(
+        charged >= observed,
+        "{case}: charge {charged} undercounts {observed} live requested bytes"
+    );
+    drop(value);
+    assert_eq!(
+        live_bytes(),
+        0,
+        "{case}: dropping the value must release every tagged allocation"
+    );
+}
+
+#[test]
+fn opaque_map_charges_cover_independently_observed_live_layouts() {
+    assert_covers_live_layout("populated NBT compound", || {
+        (0..4096)
+            .map(|i| (JavaString::from(i.to_string().as_str()), Tag::Int(i)))
+            .collect::<BTreeMap<_, _>>()
+    });
+    assert_covers_live_layout("nested maps and spare child capacities", || {
+        let mut outer = BTreeMap::new();
+        for i in 0..64 {
+            let mut inner = BTreeMap::new();
+            for j in 0..31 {
+                let mut units = Vec::with_capacity(100);
+                units.push(j);
+                let mut bytes = Vec::with_capacity(1000);
+                bytes.push(42);
+                let mut children = Vec::with_capacity(20);
+                children.push(Tag::String(JavaString(units)));
+                children.push(Tag::ByteArray(bytes));
+                inner.insert(
+                    JavaString::from(j.to_string().as_str()),
+                    Tag::List(children),
+                );
+            }
+            outer.insert(
+                JavaString::from(i.to_string().as_str()),
+                Tag::Compound(inner),
+            );
+        }
+        Tag::Compound(outer)
+    });
+    assert_covers_live_layout("insert/remove churn", || {
+        let mut map = BTreeMap::new();
+        for i in (0..4096).rev() {
+            map.insert(JavaString::from(i.to_string().as_str()), Tag::Int(i));
+        }
+        for i in 0..4096 {
+            if i % 11 != 0 {
+                map.remove(&JavaString::from(i.to_string().as_str()));
+            }
+        }
+        map
+    });
+    assert_covers_live_layout("retained empty root", || {
+        let mut map = BTreeMap::<u32, [u64; 32]>::new();
+        for i in 0..1000 {
+            map.insert(i, [0; 32]);
+        }
+        for i in 0..1000 {
+            map.remove(&i);
+        }
+        map
+    });
+
+    use horizon_protocol::{
+        packets::configuration::{RegistryData, RegistryEntry, RegistryTags, TagEntry, UpdateTags},
+        registry::Dynamic,
+        retained::fresh_hash_table_bytes,
+    };
+    use std::collections::HashSet;
+    #[repr(align(128))]
+    #[derive(Hash, PartialEq, Eq)]
+    struct Aligned(u32);
+    for requested in [1, 2, 3, 7, 14, 15, 28, 56, 1000] {
+        assert_covers_charge(
+            "fresh aligned set table",
+            || HashSet::<Aligned>::with_capacity(requested),
+            |set| fresh_hash_table_bytes::<Aligned>(set.capacity()),
+        );
+        // Small/ZST elements exercise hashbrown's minimum table sizes too.
+        assert_covers_charge(
+            "fresh zero-sized set table",
+            || HashSet::<()>::with_capacity(requested),
+            |set| fresh_hash_table_bytes::<()>(set.capacity()),
+        );
+    }
+    assert_covers_charge(
+        "fresh dynamic snapshot with replacement",
+        || {
+            let mut dynamic = Dynamic::default();
+            for round in 0..2 {
+                for i in 0..40 {
+                    let mut entries = Vec::with_capacity(100);
+                    let mut nbt = BTreeMap::new();
+                    nbt.insert(
+                        JavaString::from("nested"),
+                        Tag::ByteArray(Vec::with_capacity(3000)),
+                    );
+                    let mut name = String::with_capacity(400);
+                    name.push_str("test:entry");
+                    entries.push(RegistryEntry {
+                        id: name,
+                        data: Some(Tag::Compound(nbt)),
+                    });
+                    dynamic.add(RegistryData {
+                        registry: format!("test:registry_{i}"),
+                        entries,
+                    });
+                    let tags = (0..(20 + round))
+                        .map(|j| {
+                            let mut ids = Vec::with_capacity(500);
+                            ids.push(j);
+                            TagEntry {
+                                name: format!("test:tag_{j}"),
+                                ids,
+                            }
+                        })
+                        .collect();
+                    dynamic.add_tags(&UpdateTags {
+                        registries: vec![RegistryTags {
+                            registry: format!("test:registry_{i}"),
+                            tags,
+                        }],
+                    });
+                }
+            }
+            dynamic
+        },
+        Dynamic::fresh_owned_heap_bytes,
+    );
+}
diff --git a/crates/horizon-protocol/tools/audit_retained_std.py b/crates/horizon-protocol/tools/audit_retained_std.py
new file mode 100644
index 0000000000..dd06db4ec2
--- /dev/null
+++ b/crates/horizon-protocol/tools/audit_retained_std.py
@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+"""Audit the std B-tree and fresh hash table contracts used by retained.rs; run after a toolchain update.
+
+This deliberately fails on changed node layout/invariants rather than pretending to
+measure opaque std allocations. Install rust-src for the compiler being audited.
+"""
+import pathlib
+import re
+import subprocess
+
+sysroot = pathlib.Path(subprocess.check_output(["rustc", "--print", "sysroot"], text=True).strip())
+root = sysroot / "lib/rustlib/src/rust/library/alloc/src/collections/btree"
+source = (root / "node.rs").read_text()
+for contract in (
+    "const B: usize = 6;",
+    "const CAPACITY: usize = 2 * B - 1;",
+    "const MIN_LEN_AFTER_SPLIT: usize = B - 1;",
+    "parent: Option<NonNull<InternalNode<K, V>>>",
+    "parent_idx: MaybeUninit<u16>",
+    "len: u16",
+    "keys: [MaybeUninit<K>; CAPACITY]",
+    "vals: [MaybeUninit<V>; CAPACITY]",
+    "data: LeafNode<K, V>",
+    "edges: [MaybeUninit<BoxedNode<K, V>>; 2 * B]",
+    "type BoxedNode<K, V> = NonNull<LeafNode<K, V>>;",
+):
+    assert contract in source, f"B-tree accounting must be re-audited: {contract}"
+for name, expected_fields in (("LeafNode", 5), ("InternalNode", 2)):
+    body = re.search(rf"struct {name}<K, V> \{{(.*?)\n\}}", source, re.S).group(1)
+    fields = re.findall(r"^\s+[a-z_]+:", body, re.M)
+    assert len(fields) == expected_fields, f"{name} layout changed: {fields}"
+print(subprocess.check_output(["rustc", "--version"], text=True).strip())
+print("B-tree capacity, node fields and minimum occupancy contract match retained.rs")
+
+assert "const MIN_LEN: usize = node::MIN_LEN_AFTER_SPLIT;" in (root / "map.rs").read_text()
+assert "Every non-root node contains at least MIN_LEN elements." in (root / "map.rs").read_text()
+assert "if len < MIN_LEN" in (root / "remove.rs").read_text()
+
+# Rust 1.99.1 vendors this exact hashbrown version for std's HashMap.
+hashbrown = root.parents[3] / "vendor/hashbrown-0.17.1/src"
+raw = (hashbrown / "raw.rs").read_text()
+for contract in (
+    "self.table.items + self.table.growth_left",
+    "if bucket_mask < 8",
+    "((bucket_mask + 1) / 8) * 7",
+    "size.checked_mul(buckets)?.checked_add(ctrl_align - 1)? & !(ctrl_align - 1)",
+    "ctrl_offset.checked_add(buckets + Group::WIDTH)?",
+    "layout.align() > Group::WIDTH",
+):
+    assert contract in raw, f"fresh hash table accounting must be re-audited: {contract}"
+groups = hashbrown / "control/group"
+expected = {"sse2.rs", "neon.rs", "lsx.rs", "generic.rs", "mod.rs"}
+assert {p.name for p in groups.glob("*.rs")} == expected, "re-audit new hash control group target"
+for name, representation in (("sse2", "x86::__m128i"), ("lsx", "m128i"), ("neon", "neon::uint8x8_t"), ("generic", "GroupWord")):
+    group = (groups / f"{name}.rs").read_text()
+    assert f"struct Group({representation})" in group
+    assert "const WIDTH: usize = mem::size_of::<Self>();" in group
+assert "type GroupWord = u64;" in (groups / "generic.rs").read_text()
+assert "type GroupWord = u32;" in (groups / "generic.rs").read_text()
+print("Fresh hash table capacity/layout and <=16-byte control group contracts match retained.rs")
