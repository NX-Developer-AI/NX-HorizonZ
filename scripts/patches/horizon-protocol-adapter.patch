+        }
+        for item in [Some(594), None] {
+            // pinned minecraft:red_carpet, then unequipped
+            let (id, body) = session.next_incoming().unwrap();
+            let play::Clientbound::SetEquipment(p) = play::Clientbound::decode(id, &body).unwrap()
+            else {
