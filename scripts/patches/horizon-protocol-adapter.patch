+
+    fn old_login(version: ServerVersion) -> Vec<u8> {
+        let mut w = Writer::new();
+        w.i32(42);
+        w.bool(false);
+        w.varint(1);
+        w.string("minecraft:overworld");
+        for n in [20, 8, 6] {
+            w.varint(n);
+        }
+        for flag in [false, true, false] {
