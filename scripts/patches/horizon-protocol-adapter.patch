index 0000000000..cb3b67bb44
--- /dev/null
+++ b/crates/horizon-protocol/src/adapter/client_session/step_1_21_5.rs
@@ -0,0 +1,143 @@
+//! 1.21.6 to 1.21.5: the mirror of `translate`'s `v1_21_5` (1.21.5 to 1.21.6), for a [`super::ClientSession`] whose
+//! client is 1.21.5 (roadmap `older-clients`).
+//!
+//! Clientbound, a hanging entity's data loses the direction 1.21.6 added at index 8 ([`entity_data`]); no packet
+//! is laid out differently. Serverbound, a
+//! 1.21.5 client's `player_command` has a sneak press and release (actions 0 and 1) that 1.21.6 no longer has;
+//! the sneak is in `player_input` (bit 0x20) for both. The press and release are dropped, the other actions are
+//! numbered two up in 1.21.5 and come back down here.
+//!
+//! Item components are written in 1.21.5's layout by `item.rs` (`ids::Quirks::components_before_1_21_6`).
+//!
+//! TODO(step3): 1.21.6's dialog registries are not written for 1.21.5; see translate's `v1_21_5`.
+use crate::{
+    Result, State,
+    adapter::pinned_ids::entity_type as entity,
+    buf::{Reader, Writer},
+    ids as packet_ids,
+    packets::play,
+};
+
+/// What becomes of a payload the 1.21.5 client sent.
+#[derive(Debug, PartialEq)]
+pub(super) enum Out {
+    /// Not one of the packets this step rewrites.
+    Untouched,
+    Rewritten(Vec<u8>),
+    /// A sneak press or release (or an action 1.21.5 has no number for), which the pinned version doesn't read.
+    Dropped,
+}
+
+/// 1.21.6 gave hanging entities (item frames, glow item frames, paintings) a synchronised direction at index 8
+/// and moved their other fields up one (`translate::v1_21_5::entity_data`, back): a client through 1.21.5 is
+/// not sent the direction (it has it from `add_entity`), and the fields after it come back down. A real 1.21.5
+/// client left with "Invalid entity data item type for field 8" at the first item frame holding an item.
+/// `kind` is the entity's type in the pinned ids, `None` when unknown, which leaves the data as it is.
+pub(super) fn entity_data(kind: Option<i32>, data: &mut play::SetEntityData) {
+    if !matches!(
+        kind,
+        Some(entity::GLOW_ITEM_FRAME | entity::ITEM_FRAME | entity::PAINTING)
+    ) {
+        return;
+    }
+    data.values.retain(|(index, _, _)| *index != 8);
+    for (index, _, _) in &mut data.values {
+        if *index > 8 {
+            *index -= 1;
+        }
+    }
+}
+
+/// Nothing: no packet the pinned version sends is laid out differently for 1.21.5 (see `translate::v1_21_5`).
+pub(super) fn clientbound(_state: State, _id: i32, _payload: &[u8]) -> Result<Option<Vec<u8>>> {
+    Ok(None)
+}
+
+/// The 1.21.5 serverbound packet `id` (`payload` as the client sent it, under the pinned id) in the pinned layout.
+pub(super) fn serverbound(state: State, id: i32, payload: &[u8]) -> Result<Out> {
+    use packet_ids::play::serverbound as sb;
+    Ok(match (state, id) {
+        (State::Play, sb::PLAYER_COMMAND) => player_command(payload)?,
+        _ => Out::Untouched,
+    })
+}
+
+/// 1.21.5's actions 2 to 8 are the pinned 0 to 6; its press (0) and release (1) of the sneak key go.
+fn player_command(payload: &[u8]) -> Result<Out> {
+    let mut r = Reader::new(payload);
+    let entity = r.varint()?;
+    let action = r.varint()?;
+    let jump = r.varint()?;
+    let action = match action {
+        2..=8 => action - 2,
+        _ => return Ok(Out::Dropped),
+    };
+    let mut w = Writer::new();
+    w.varint(entity);
+    w.varint(action);
+    w.varint(jump);
+    Ok(Out::Rewritten(w.data))
+}
+
+#[cfg(test)]
+mod tests {
+    //! Each change is written here and read back with `translate`'s 1.21.5 reader: the round trip.
+    use super::*;
+    use crate::adapter::{ServerVersion, session::Session, translate};
+
+    fn command(entity: i32, action: i32, jump: i32) -> Vec<u8> {
+        let mut w = Writer::new();
+        w.varint(entity);
+        w.varint(action);
+        w.varint(jump);
+        w.data
+    }
+
+    #[test]
+    fn a_1_21_5_leave_bed_is_the_pinned_zero() {
+        let id = packet_ids::play::serverbound::PLAYER_COMMAND;
+        assert_eq!(
+            serverbound(State::Play, id, &command(4, 2, 0)).unwrap(),
+            Out::Rewritten(command(4, 0, 0))
+        );
+    }
+
+    #[test]
+    fn a_sneak_press_and_release_are_dropped() {
+        let id = packet_ids::play::serverbound::PLAYER_COMMAND;
+        assert_eq!(
+            serverbound(State::Play, id, &command(4, 0, 0)).unwrap(),
+            Out::Dropped
+        );
+        assert_eq!(
+            serverbound(State::Play, id, &command(4, 1, 0)).unwrap(),
+            Out::Dropped
+        );
+    }
+
+    #[test]
+    fn other_packets_are_untouched() {
+        let id = packet_ids::play::serverbound::PLAYER_INPUT;
+        assert_eq!(
+            serverbound(State::Play, id, &[0x20]).unwrap(),
+            Out::Untouched
+        );
+    }
+
+    #[test]
+    fn a_pinned_command_reads_back_as_it_was() {
+        let session = Session::new(ServerVersion::V1_21_5);
+        let id = packet_ids::play::serverbound::PLAYER_COMMAND;
+        for action in 0..=6 {
+            let pinned = command(9, action, 0);
+            let (_, older) =
+                translate::client_layout_v1_21_5::player_command(&session, id, &pinned)
+                    .unwrap()
+                    .unwrap();
+            assert_eq!(
+                serverbound(State::Play, id, &older).unwrap(),
+                Out::Rewritten(pinned)
+            );
+        }
+    }
+}
diff --git a/crates/horizon-protocol/src/adapter/client_session/step_1_21_6.rs b/crates/horizon-protocol/src/adapter/client_session/step_1_21_6.rs
new file mode 100644
index 0000000000..cc2454a467
--- /dev/null
+++ b/crates/horizon-protocol/src/adapter/client_session/step_1_21_6.rs
@@ -0,0 +1,195 @@
+//! 1.21.8's packets in 1.21.6's layout for a 1.21.6 client (and 1.21.5): the mirror of `translate`'s `mod v1_21_6`
+//! (1.21.6 to 1.21.8). Two packets differ, and entity data is laid out alike.
+//! - set_equipment: 1.21.8 added the saddle slot (7) to its equipment enum. A 1.21.6 client has no such slot, so
+//!   its entries are removed. A packet with nothing else in it is dropped.
+//! - serverbound test_instance_block_action: a test is an identifier in 1.21.8 and a VarInt id in 1.21.6. A
+//!   packet that names a test is dropped (see `translate::v1_21_6::names_test`); one that names none is laid
+//!   out alike and passes.
+//!
+//! Entity data: no index or type changed between 1.21.6 and 1.21.8. The serializer ids differ only from 1.21.9.
+use crate::{
+    Result, State,
+    adapter::translate,
+    buf::{Codec, Reader},
+    ids as packet_ids,
+    packets::play,
+};
+
+/// What becomes of a payload the 1.21.8 side sent or the client was sent.
+#[derive(Debug, PartialEq)]
+pub(super) enum Out {
+    /// Laid out alike: the payload passes as it is.
+    Untouched,
+    Rewritten(Vec<u8>),
+    /// The 1.21.6 client can't read it: it is not sent (clientbound) or not read (serverbound).
+    Dropped,
+}
+
+/// EquipmentSlot.SADDLE, new in 1.21.8.
+const SADDLE: u8 = 7;
+
+/// The pinned clientbound packet `id` (`payload` in 1.21.8's layout) in 1.21.6's layout.
+pub(super) fn clientbound(state: State, id: i32, payload: &[u8]) -> Result<Out> {
+    use packet_ids::play::clientbound as cb;
+    if (state, id) != (State::Play, cb::SET_EQUIPMENT) {
+        return Ok(Out::Untouched);
+    }
+    // The stacks are already in the client's item and component ids: read and written back in those (reading
+    // them as the pinned ones misreads a component, an NBT error for every 1.21.6-and-older client).
+    let mut e = super::read_in_client_ids(|| play::SetEquipment::read(&mut Reader::new(payload)))?;
+    let before = e.slots.len();
+    e.slots.retain(|(slot, _)| *slot != SADDLE);
+    if e.slots.len() == before {
+        return Ok(Out::Untouched);
+    }
+    if e.slots.is_empty() {
+        return Ok(Out::Dropped);
+    }
+    Ok(Out::Rewritten(super::write_in_client_ids(|w| {
+        play::SetEquipment::write(&e, w)
+    })))
+}
+
+/// The pinned serverbound packet `id` as the 1.21.6 client sent it (`payload`) in 26.3's layout, for the server.
+pub(super) fn serverbound(state: State, id: i32, payload: &[u8]) -> Result<Out> {
+    use packet_ids::play::serverbound as sb;
+    if (state, id) == (State::Play, sb::TEST_INSTANCE_BLOCK_ACTION)
+        && translate::v1_21_6::names_test(payload)?
+    {
+        return Ok(Out::Dropped);
+    }
+    Ok(Out::Untouched)
+}
+
+#[cfg(test)]
+mod tests {
+    //! Each packet written here is read back with `translate`'s 1.21.6 reader (the serverbound one, which
+    //! takes the 1.21.8 layout the client sends) or the pinned codec for the clientbound one.
+    use super::*;
+    use crate::buf::Writer;
+    use crate::{
+        adapter::{ServerVersion, session::Session},
+        item::Stack,
+    };
+
+    #[test]
+    fn set_equipment_loses_the_saddle_and_keeps_the_other_slots() {
+        let stack = Stack::new(1, 1);
+        let p = play::SetEquipment {
+            id: 4,
+            slots: vec![
+                (0, Some(stack.clone())),
+                (SADDLE, Some(stack.clone())),
+                (5, None),
+            ],
+        };
+        let mut w = Writer::new();
+        play::SetEquipment::write(&p, &mut w);
+        let Out::Rewritten(body) = clientbound(
+            State::Play,
+            packet_ids::play::clientbound::SET_EQUIPMENT,
+            &w.data,
+        )
+        .unwrap() else {
+            panic!("the saddle should be removed");
+        };
+        // The top bit of the last entry is clear again: read back, the list is the two others.
+        let back = play::SetEquipment::read(&mut Reader::new(&body)).unwrap();
+        assert_eq!(
+            back,
+            play::SetEquipment {
+                id: 4,
+                slots: vec![(0, Some(stack)), (5, None)],
+            }
+        );
+    }
+
+    #[test]
+    fn set_equipment_of_only_a_saddle_is_dropped() {
+        let p = play::SetEquipment {
+            id: 4,
+            slots: vec![(SADDLE, Some(Stack::new(1, 1)))],
+        };
+        let mut w = Writer::new();
+        play::SetEquipment::write(&p, &mut w);
+        assert_eq!(
+            clientbound(
+                State::Play,
+                packet_ids::play::clientbound::SET_EQUIPMENT,
+                &w.data
+            )
+            .unwrap(),
+            Out::Dropped
+        );
+    }
+
+    #[test]
+    fn set_equipment_without_a_saddle_is_untouched() {
+        let p = play::SetEquipment {
+            id: 4,
+            slots: vec![(6, None)],
+        };
+        let mut w = Writer::new();
+        play::SetEquipment::write(&p, &mut w);
+        assert_eq!(
+            clientbound(
+                State::Play,
+                packet_ids::play::clientbound::SET_EQUIPMENT,
+                &w.data
+            )
+            .unwrap(),
+            Out::Untouched
+        );
+    }
+
+    /// A serverbound test_instance_block_action with the given test, in 26.3's layout.
+    fn test_action(test: Option<&str>) -> Vec<u8> {
+        let p = play::TestInstanceBlockAction {
+            pos: [1, 2, 3],
+            action: 6,
+            data: play::TestInstanceData {
+                test: test.map(str::to_string),
+                size: [3, 4, 5],
+                rotation: 2,
+                ignore_entities: true,
+                status: 1,
+                error_message: None,
+            },
+        };
+        let mut w = Writer::new();
+        play::TestInstanceBlockAction::write(&p, &mut w);
+        w.data
+    }
+
+    #[test]
+    fn a_test_action_naming_no_test_passes_both_ways() {
+        let session = Session::new(ServerVersion::V1_21_6);
+        let payload = test_action(None);
+        let sb = packet_ids::play::serverbound::TEST_INSTANCE_BLOCK_ACTION;
+        // The client's side: the reader passes it, renumbered to 1.21.6's id.
+        let (_, read) = translate::serverbound(&session, State::Play, sb, &payload)
+            .unwrap()
+            .unwrap();
+        assert_eq!(read, payload);
+        // The writer (the client's own packet, back up to the pinned layout) leaves it alone.
+        assert_eq!(
+            serverbound(State::Play, sb, &payload).unwrap(),
+            Out::Untouched
+        );
+    }
+
+    #[test]
+    fn a_test_action_naming_a_test_is_dropped_both_ways() {
+        let session = Session::new(ServerVersion::V1_21_6);
+        let payload = test_action(Some("minecraft:always_pass"));
+        let sb = packet_ids::play::serverbound::TEST_INSTANCE_BLOCK_ACTION;
+        assert_eq!(
+            translate::serverbound(&session, State::Play, sb, &payload).unwrap(),
+            None
+        );
+        assert_eq!(
+            serverbound(State::Play, sb, &payload).unwrap(),
+            Out::Dropped
+        );
+    }
+}
diff --git a/crates/horizon-protocol/src/adapter/client_session/step_1_21_8.rs b/crates/horizon-protocol/src/adapter/client_session/step_1_21_8.rs
new file mode 100644
index 0000000000..83df42de52
--- /dev/null
+++ b/crates/horizon-protocol/src/adapter/client_session/step_1_21_8.rs
@@ -0,0 +1,301 @@
+//! 1.21.10's packets in 1.21.8's layout for a 1.21.8 client (and 1.21.7, protocol 772): the mirror of `translate`'s
+//! `mod v1_21_8` (1.21.8 to 1.21.10). Five packets change layout: add_entity and set_entity_motion (the LpVec3
+//! velocity becomes three shorts), set_default_spawn_position (the dimension name and the pitch go),
+//! player_rotation (the relative flags go) and explode (the radius, the block count and the block particles go).
+//! Entity data: a player's main hand and skin parts move back to 18 and 17, its hearts and score to 15 and 16, and
+//! the shoulder data (19, 20), which 1.21.8 sends as an NBT, is dropped.
+//!
+//! The 1.21.10 entity data steps come before this one ([`entity_data`] reads 1.21.10's indexes and types). The
+//! debug packets 1.21.10 added and the serverbound debug subscription have no 1.21.8 counterpart the id tables
+//! pair them with, so they are dropped there, and nothing here touches serverbound packets.
+use crate::{
+    Result, State,
+    adapter::translate::{v1_21_8::VELOCITY_UNIT, v1_21_10::PLAYER},
+    buf::{Codec, LpVec3, Opt, Reader, Vec3d, Writer},
+    ids as packet_ids,
+    packets::play::{self, SoundHolder},
+};
+
+/// The pinned clientbound packet `id` (`payload` in 1.21.10's layout) in 1.21.8's layout; `None` when laid out
+/// alike.
+pub(super) fn clientbound(state: State, id: i32, payload: &[u8]) -> Result<Option<Vec<u8>>> {
+    use packet_ids::play::clientbound as cb;
+    if state != State::Play {
+        return Ok(None);
+    }
+    Ok(match id {
+        cb::ADD_ENTITY => Some(add_entity(payload)?),
+        cb::SET_ENTITY_MOTION => Some(set_entity_motion(payload)?),
+        cb::SET_DEFAULT_SPAWN_POSITION => Some(spawn_position(payload)?),
+        cb::PLAYER_ROTATION => Some(player_rotation(payload)?),
+        cb::EXPLODE => Some(explode(payload)?),
+        _ => None,
+    })
+}
+
+/// A velocity component as 1.21.8's short: 1/8000 of a block per tick, clamped to the short's range.
+fn to_short(v: f64) -> i16 {
+    (v * VELOCITY_UNIT)
+        .round()
+        .clamp(f64::from(i16::MIN), f64::from(i16::MAX)) as i16
+}
+
+/// add_entity: the LpVec3 after the position becomes three shorts after the data.
+fn add_entity(payload: &[u8]) -> Result<Vec<u8>> {
+    let mut r = Reader::new(payload);
+    let mut w = Writer::new();
+    w.varint(r.varint()?);
+    w.uuid(r.uuid()?);
+    w.varint(r.varint()?);
+    for _ in 0..3 {
+        w.f64(r.f64()?);
+    }
+    let velocity = LpVec3::read(&mut r)?;
+    let angles = [r.u8()?, r.u8()?, r.u8()?];
+    let data = r.varint()?;
+    w.bytes(&angles);
+    w.varint(data);
+    for v in velocity {
+        w.i16(to_short(v));
+    }
+    Ok(w.data)
+}
+
+/// set_entity_motion: the LpVec3 becomes three shorts.
+fn set_entity_motion(payload: &[u8]) -> Result<Vec<u8>> {
+    let mut r = Reader::new(payload);
+    let mut w = Writer::new();
+    w.varint(r.varint()?);
+    for v in LpVec3::read(&mut r)? {
+        w.i16(to_short(v));
+    }
+    Ok(w.data)
+}
+
+/// set_default_spawn_position: the dimension name goes, and the pitch; the yaw is the one angle.
+fn spawn_position(payload: &[u8]) -> Result<Vec<u8>> {
+    let mut r = Reader::new(payload);
+    let _dimension = r.string(32767)?;
+    let position = r.i64()?;
+    let yaw = r.f32()?;
+    let _pitch = r.f32()?;
+    let mut w = Writer::new();
+    w.i64(position);
+    w.f32(yaw);
+    Ok(w.data)
+}
+
+/// player_rotation: the relative flags go. 1.21.8 has no relative rotation, so a relative one is sent as the
+/// absolute angle it names, which is wrong.
+// TODO(step1.21.8): a relative rotation (flag set) is read as absolute; 1.21.8 has no way to send one.
+fn player_rotation(payload: &[u8]) -> Result<Vec<u8>> {
+    let mut r = Reader::new(payload);
+    let yaw = r.f32()?;
+    r.bool()?;
+    let pitch = r.f32()?;
+    r.bool()?;
+    let mut w = Writer::new();
+    w.f32(yaw);
+    w.f32(pitch);
+    Ok(w.data)
+}
+
+/// explode: the centre, the knockback, the particle and the sound stay; the radius, the block count and the block
+/// particles go.
+fn explode(payload: &[u8]) -> Result<Vec<u8>> {
+    // The pinned read ends with a play-sound flag 1.21.10 does not have: a set one is appended to read it.
+    let mut body = payload.to_vec();
+    body.push(1);
+    let e = super::read_in_client_ids(|| play::Explode::read(&mut Reader::new(&body)))?;
+    Ok(super::write_in_client_ids(|w| {
+        Vec3d::write(&e.center, w);
+        <Opt<Vec3d>>::write(&e.knockback, w);
+        e.particle.write(w);
+        SoundHolder::write(&e.sound, w);
+    }))
+}
+
+/// Entity data of a player, 1.21.10's layout to 1.21.8's (translate's `v1_21_8::entity_data`, reversed), after
+/// [`super::step_1_21_10::entity_data`]. `kind` is the entity's type in the pinned ids, `None` when the caller
+/// doesn't know it, which leaves the data as it is.
+pub(super) fn entity_data(kind: Option<i32>, data: &mut play::SetEntityData) {
+    let Some(kind) = kind else {
+        return;
+    };
+    if kind != PLAYER {
+        return;
+    }
+    // The shoulder data (an NBT in 1.21.8) is dropped: a 1.21.8 client does not show the parrot.
+    // TODO(step1.21.8): write 1.21.8's NBT (a parrot with its variant) instead of dropping it.
+    data.values
+        .retain(|(index, _, _)| !matches!(*index, 19 | 20));
+    for (index, _, _) in &mut data.values {
+        *index = match *index {
+            15 => 18,
+            16 => 17,
+            17 => 15,
+            18 => 16,
+            other => other,
+        };
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    //! Each change written here is read back with `translate`'s 1.21.8 reader: the full chain, 1.21.8's layout
+    //! to 1.21.10's and back again, byte for byte where the layouts carry the same information.
+    use super::*;
+    use crate::{
+        adapter::{ServerVersion, session::Session, translate},
+        entity_data::{Value, serializer as ser},
+    };
+
+    /// 1.21.8's packet, read by translate's 1.21.8 reader, then written back by this step.
+    fn round_trip(session: &Session, id: i32, body: &[u8]) -> Vec<u8> {
+        let up = translate::client_layout_v1_21_8::clientbound(session, State::Play, id, body)
+            .unwrap()
+            .expect("1.21.8 packet has a 1.21.10 layout");
+        clientbound(State::Play, id, &up)
+            .unwrap()
+            .expect("1.21.10 packet has a 1.21.8 layout")
+    }
+
+    fn short_velocity_body(entity: i32) -> Vec<u8> {
+        let mut w = Writer::new();
+        w.varint(entity);
+        w.uuid(0x0123_4567_89ab_cdef_0123_4567_89ab_cdef);
+        w.varint(5);
+        w.f64(1.5);
+        w.f64(-64.25);
+        w.f64(3.0);
+        w.u8(10);
+        w.u8(200);
+        w.u8(7);
+        w.varint(9);
+        w.i16(1343);
+        w.i16(-2000);
+        w.i16(0);
+        w.data
+    }
+
+    #[test]
+    fn add_entity_round_trips_through_an_lpvec3() {
+        let session = Session::new(ServerVersion::V1_21_8);
+        let body = short_velocity_body(0);
+        assert_eq!(
+            round_trip(&session, packet_ids::play::clientbound::ADD_ENTITY, &body),
+            body
+        );
+    }
+
+    #[test]
+    fn set_entity_motion_round_trips_through_an_lpvec3() {
+        let session = Session::new(ServerVersion::V1_21_8);
+        let mut w = Writer::new();
+        w.varint(42);
+        w.i16(-1343);
+        w.i16(8000);
+        w.i16(12);
+        let body = w.data;
+        let id = packet_ids::play::clientbound::SET_ENTITY_MOTION;
+        assert_eq!(round_trip(&session, id, &body), body);
+    }
+
+    #[test]
+    fn spawn_position_and_rotation_round_trip() {
+        let session = Session::new(ServerVersion::V1_21_8);
+        let mut w = Writer::new();
+        w.i64(0x1234_5678);
+        w.f32(90.0);
+        let spawn = w.data;
+        let id = packet_ids::play::clientbound::SET_DEFAULT_SPAWN_POSITION;
+        assert_eq!(round_trip(&session, id, &spawn), spawn);
+
+        let mut w = Writer::new();
+        w.f32(-45.5);
+        w.f32(12.25);
+        let rotation = w.data;
+        let id = packet_ids::play::clientbound::PLAYER_ROTATION;
+        assert_eq!(round_trip(&session, id, &rotation), rotation);
+    }
+
+    #[test]
+    fn explode_drops_what_1_21_8_never_sent() {
+        let session = Session::new(ServerVersion::V1_21_8);
+        let mut w = Writer::new();
+        w.f64(10.0);
+        w.f64(64.0);
+        w.f64(-3.0);
+        w.bool(true); // a knockback
+        w.f64(0.5);
+        w.f64(0.0);
+        w.f64(-0.25);
+        w.varint(0); // the particle (no data)
+        w.varint(5); // the sound, by id + 1
+        let body = w.data;
+        let id = packet_ids::play::clientbound::EXPLODE;
+        assert_eq!(round_trip(&session, id, &body), body);
+
+        // And the 1.21.10 side the pinned reader sees: the radius and count it was given, no block particles.
+        let up = translate::client_layout_v1_21_8::clientbound(&session, State::Play, id, &body)
+            .unwrap()
+            .unwrap();
+        let mut up = up;
+        up.push(1);
+        let e = play::Explode::read(&mut Reader::new(&up)).unwrap();
+        assert_eq!(e.radius, 3.0);
+        assert_eq!(e.block_count, 0);
+        assert!(e.block_particles.is_empty());
+        assert_eq!(e.knockback, Some([0.5, 0.0, -0.25]));
+    }
+
+    #[test]
+    fn a_player_s_main_hand_and_hearts_move_back_to_1_21_8_s_indexes() {
+        let session = Session::new(ServerVersion::V1_21_8);
+        session.kinds.lock().unwrap().insert(2, PLAYER);
+        // 1.21.10's order: main hand, skin parts, hearts, score and the shoulders (dropped here).
+        let player = play::SetEntityData {
+            id: 2,
+            values: vec![
+                (15, ser::BYTE, Value::Byte(1)),
+                (16, ser::BYTE, Value::Byte(0x7f)),
+                (17, ser::FLOAT, Value::Float(4.0)),
+                (18, ser::INT, Value::Int(3)),
+                (19, ser::OPTIONAL_UNSIGNED_INT, Value::Id(0)),
+            ],
+        };
+        let mut d = player.clone();
+        entity_data(Some(PLAYER), &mut d);
+        assert_eq!(
+            d.values,
+            vec![
+                (18, ser::BYTE, Value::Byte(1)),
+                (17, ser::BYTE, Value::Byte(0x7f)),
+                (15, ser::FLOAT, Value::Float(4.0)),
+                (16, ser::INT, Value::Int(3)),
+            ]
+        );
+        // The way back, by translate's reader, gives 1.21.10's order again, minus the shoulders.
+        let mut back = d.clone();
+        translate::client_layout_v1_21_8::entity_data(&session, &mut back);
+        assert_eq!(
+            back.values,
+            vec![
+                (15, ser::BYTE, Value::Byte(1)),
+                (16, ser::BYTE, Value::Byte(0x7f)),
+                (17, ser::FLOAT, Value::Float(4.0)),
+                (18, ser::INT, Value::Int(3)),
+            ]
+        );
+    }
+
+    #[test]
+    fn an_unknown_kind_is_left_alone() {
+        let mut d = play::SetEntityData {
+            id: 4,
+            values: vec![(18, ser::INT, Value::Int(9))],
+        };
+        entity_data(None, &mut d);
+        assert_eq!(d.values, vec![(18, ser::INT, Value::Int(9))]);
+    }
+}
diff --git a/crates/horizon-protocol/src/adapter/client_session/step_26_1.rs b/crates/horizon-protocol/src/adapter/client_session/step_26_1.rs
new file mode 100644
index 0000000000..9c4865ed8b
--- /dev/null
+++ b/crates/horizon-protocol/src/adapter/client_session/step_26_1.rs
@@ -0,0 +1,318 @@
+//! 26.2 to 26.1: the mirror of `translate`'s `v26_1` (26.1 to 26.2), for a [`super::ClientSession`] whose client
+//! is 26.1 (roadmap `older-clients`). What the pinned release sends is in 26.2's layout by then ([`super::world`]
+//! and [`super::super::layout_26_2`]); this writes 26.1's.
+//!
+//! Only the packets `v26_1` changes are here; translate's `v26_1` renumbers no id itself, so none is added or
+//! dropped on this step.
+//! Serverbound, 26.1's `spectate_entity` (by UUID) is the pinned `spectator_action` (by network id), which needs
+//! the entities the session has been told of, so the caller passes their lookup.
+use crate::{
+    Error, Result, State,
+    adapter::translate,
+    buf::{Codec, Opt, OptVarInt, Reader, VarInt, Writer},
+    ids as packet_ids,
+};
+
+/// `ChatFormatting.RESET`, which 26.1 sends for a team without a colour.
+const RESET: i32 = 21;
+
+/// What becomes of a payload the 26.1 client sent.
+#[derive(Debug, PartialEq)]
+pub(super) enum Out {
+    /// Not one of the packets this step rewrites.
+    Untouched,
+    Rewritten(Vec<u8>),
+    /// The pinned server has nothing to read it as: the entity it names was never added to the client.
+    Dropped,
+}
+
+/// The pinned clientbound packet `id` in 26.2's layout, in 26.1's; `None` when 26.1 lays it out alike.
+pub(super) fn clientbound(state: State, id: i32, payload: &[u8]) -> Result<Option<Vec<u8>>> {
+    use packet_ids::play::clientbound as cb;
+    Ok(match (state, id) {
+        (State::Login, packet_ids::login::clientbound::LOGIN_FINISHED) => {
+            Some(login_finished(payload)?)
+        }
+        (State::Play, cb::LOGIN) => Some(login(payload)?),
+        (State::Play, cb::SET_PLAYER_TEAM) => Some(team(payload)?),
+        // ADD_ENTITY and REMOVE_ENTITIES are laid out alike. 26.1's spectate_entity needs the UUID of each
+        // entity added, which the session keeps (translate's v26_1 does the same the other way).
+        // ADD_ENTITY's (id, UUID) are kept by `ClientSession::track_entities`.
+        _ => None,
+    })
+}
+
+/// The pinned serverbound packet `id` (`payload` as 26.1 sent it) in 26.2's layout. `id` is the pinned
+/// `spectator_action`, which 26.1's `spectate_entity` maps to. `entity_of` finds the network id of an entity by
+/// its UUID: the session's `uuids`, reversed.
+pub(super) fn serverbound(
+    state: State,
+    id: i32,
+    payload: &[u8],
+    entity_of: impl Fn(u128) -> Option<i32>,
+) -> Result<Out> {
+    use packet_ids::play::serverbound as sb;
+    Ok(match (state, id) {
+        (State::Play, sb::SPECTATOR_ACTION) => spectate(payload, entity_of)?,
+        _ => Out::Untouched,
+    })
+}
+
+/// 26.2 appends the session's id, 16 bytes, to the profile; 26.1 has none, so they go.
+fn login_finished(payload: &[u8]) -> Result<Vec<u8>> {
+    let Some(end) = payload.len().checked_sub(16) else {
+        return Err(Error::new("login finished shorter than its session id"));
+    };
+    Ok(payload[..end].to_vec())
+}
+
+/// 26.2 tells the client whether the server checks accounts (online_mode), a bool after the spawn info; 26.1
+/// has none, so it goes.
+fn login(payload: &[u8]) -> Result<Vec<u8>> {
+    let mut r = Reader::new(payload);
+    r.i32()?;
+    r.bool()?;
+    let n = r.count(r.remaining())?;
+    for _ in 0..n {
+        r.string(32767)?;
+    }
+    for _ in 0..3 {
+        r.varint()?;
+    }
+    for _ in 0..3 {
+        r.bool()?;
+    }
+    translate::spawn_info(&mut r, crate::adapter::ServerVersion::V26_2)?;
+    let at = r.position();
+    r.bool()?;
+    let mut body = payload[..at].to_vec();
+    body.extend_from_slice(&payload[at + 1..]);
+    Ok(body)
+}
+
+/// 26.2's team parameters (the pinned layout): display name, prefix, suffix, visibility, collision, an
+/// optional TeamColor, options. 26.1 sends the display name, options, visibility, collision, a ChatFormatting
+/// (RESET for none), prefix, suffix. The players that follow are the same in both.
+fn team(payload: &[u8]) -> Result<Vec<u8>> {
+    let mut r = Reader::new(payload);
+    let mut w = Writer::new();
+    w.string(&r.string(32767)?);
+    let method = r.i8()?;
+    w.i8(method);
+    if method == 0 || method == 2 {
+        let display = r.nbt()?;
+        let prefix = r.nbt()?;
+        let suffix = r.nbt()?;
+        let visibility = r.varint()?;
+        let collision = r.varint()?;
+        let color = <Opt<VarInt>>::read(&mut r)?;
+        let options = r.i8()?;
+        w.nbt(&display);
+        w.i8(options);
+        w.varint(visibility);
+        w.varint(collision);
+        w.varint(color.unwrap_or(RESET));
+        w.nbt(&prefix);
+        w.nbt(&suffix);
+    }
+    w.bytes(r.rest());
+    Ok(w.data)
+}
+
+/// 26.1's spectate_entity names an entity by its UUID, the pinned spectator_action by its network id
+/// (translate's `v26_1::spectate`, the other way). Dropped for an entity the client was never told of.
+fn spectate(payload: &[u8], entity_of: impl Fn(u128) -> Option<i32>) -> Result<Out> {
+    let mut r = Reader::new(payload);
+    let uuid = r.uuid()?;
+    let Some(entity) = entity_of(uuid) else {
+        return Ok(Out::Dropped);
+    };
+    let mut w = Writer::new();
+    <OptVarInt>::write(&Some(entity), &mut w);
+    Ok(Out::Rewritten(w.data))
+}
+
+#[cfg(test)]
+mod tests {
+    //! Each packet written here in 26.1's layout is read back with `translate`'s 26.1 reader, which brings it to
+    //! 26.2's again. Packets 26.2 has more of than 26.1 (the online_mode bool, the session id) come back as
+    //! 26.1's reader reads them: offline, and an all-zero id.
+    use super::*;
+    use crate::{
+        adapter::{ServerVersion, Session},
+        packets::play,
+    };
+    use horizon_world::nbt::Tag;
+
+    use packet_ids::play::clientbound as cb;
+
+    /// A login as 26.2 sends it, with the given online_mode and an enforced secure chat.
+    fn login_26_2(online_mode: bool) -> Vec<u8> {
+        let mut w = Writer::new();
+        w.i32(7);
+        w.bool(false);
+        w.varint(1);
+        w.string("minecraft:overworld");
+        w.varint(20);
+        w.varint(10);
+        w.varint(8);
+        w.bool(false);
+        w.bool(true);
+        w.bool(false);
+        // The spawn info, with the game types as bytes (-1 for no previous one).
+        w.varint(0);
+        w.string("minecraft:overworld");
+        w.i64(1234);
+        w.i8(0);
+        w.i8(-1);
+        w.bool(false);
+        w.bool(false);
+        <Opt<play::GlobalPos>>::write(&None, &mut w);
+        w.varint(0);
+        w.varint(63);
+        w.bool(online_mode);
+        w.bool(true);
+        w.data
+    }
+
+    /// A team update as 26.2 sends it: `color` only for methods 0 and 2 (the parameters), 3 adds a player.
+    fn team_26_2(method: i8, color: Option<i32>) -> Vec<u8> {
+        let mut w = Writer::new();
+        w.string("red");
+        w.i8(method);
+        if method == 0 || method == 2 {
+            w.nbt(&Tag::String("Red".into()));
+            w.nbt(&Tag::String("[".into()));
+            w.nbt(&Tag::String("]".into()));
+            w.varint(1);
+            w.varint(2);
+            <Opt<VarInt>>::write(&color, &mut w);
+            w.i8(3);
+        }
+        if method == 0 || method == 3 {
+            w.varint(1);
+            w.string("Steve");
+        }
+        w.data
+    }
+
+    #[test]
+    fn an_offline_login_goes_down_and_back_up() {
+        let session = Session::new(ServerVersion::V26_1);
+        let original = login_26_2(false);
+        let down = clientbound(State::Play, cb::LOGIN, &original)
+            .unwrap()
+            .unwrap();
+        // 26.1 has no online_mode byte: one less.
+        assert_eq!(down.len() + 1, original.len());
+        let back = translate::v26_1::clientbound(&session, State::Play, cb::LOGIN, &down)
+            .unwrap()
+            .unwrap();
+        assert_eq!(back, original);
+    }
+
+    #[test]
+    fn an_online_login_reads_back_as_offline() {
+        let session = Session::new(ServerVersion::V26_1);
+        let down = clientbound(State::Play, cb::LOGIN, &login_26_2(true))
+            .unwrap()
+            .unwrap();
+        let back = translate::v26_1::clientbound(&session, State::Play, cb::LOGIN, &down)
+            .unwrap()
+            .unwrap();
+        assert_eq!(back, login_26_2(false));
+    }
+
+    #[test]
+    fn a_team_goes_down_and_back_up() {
+        let session = Session::new(ServerVersion::V26_1);
+        let id = cb::SET_PLAYER_TEAM;
+        for (method, color) in [(0, Some(12)), (2, None), (3, None)] {
+            let original = team_26_2(method, color);
+            let down = clientbound(State::Play, id, &original).unwrap().unwrap();
+            let back = translate::v26_1::clientbound(&session, State::Play, id, &down)
+                .unwrap()
+                .unwrap();
+            assert_eq!(back, original, "method {method}");
+        }
+    }
+
+    #[test]
+    fn a_team_without_a_colour_is_reset_for_26_1() {
+        let down = clientbound(State::Play, cb::SET_PLAYER_TEAM, &team_26_2(2, None))
+            .unwrap()
+            .unwrap();
+        let mut r = Reader::new(&down);
+        assert_eq!(r.string(32767).unwrap(), "red");
+        assert_eq!(r.i8().unwrap(), 2);
+        r.nbt().unwrap();
+        r.i8().unwrap();
+        r.varint().unwrap();
+        r.varint().unwrap();
+        assert_eq!(r.varint().unwrap(), RESET);
+    }
+
+    #[test]
+    fn the_session_id_goes_and_the_profile_stays() {
+        let session = Session::new(ServerVersion::V26_1);
+        let id = packet_ids::login::clientbound::LOGIN_FINISHED;
+        let mut w = Writer::new();
+        w.uuid(0x1234);
+        w.string("Steve");
+        w.varint(0);
+        let profile = w.data;
+        let mut original = profile.clone();
+        original.extend_from_slice(&[7; 16]);
+        let down = clientbound(State::Login, id, &original).unwrap().unwrap();
+        assert_eq!(down, profile);
+        // translate gives 26.2 an all-zero session id back.
+        let back = translate::v26_1::clientbound(&session, State::Login, id, &down)
+            .unwrap()
+            .unwrap();
+        let mut zeroed = profile;
+        zeroed.extend_from_slice(&[0; 16]);
+        assert_eq!(back, zeroed);
+        assert!(clientbound(State::Login, id, &[0; 15]).is_err());
+    }
+
+    #[test]
+    fn a_spectated_entity_goes_up_by_its_network_id() {
+        let session = Session::new(ServerVersion::V26_1);
+        let uuid = 0x42u128;
+        session.uuids.lock().unwrap().insert(7, uuid);
+        let mut w = Writer::new();
+        w.uuid(uuid);
+        let id = packet_ids::play::serverbound::SPECTATOR_ACTION;
+        let Out::Rewritten(up) =
+            serverbound(State::Play, id, &w.data, |u| (u == uuid).then_some(7)).unwrap()
+        else {
+            panic!("not rewritten");
+        };
+        assert_eq!(<OptVarInt>::read(&mut Reader::new(&up)).unwrap(), Some(7));
+        // translate's reader turns it back into 26.1's spectate_entity (62) with the same UUID.
+        assert_eq!(
+            translate::v26_1::spectate(&session, &up).unwrap(),
+            Some((62, w.data))
+        );
+    }
+
+    #[test]
+    fn a_spectated_entity_never_added_is_dropped() {
+        let mut w = Writer::new();
+        w.uuid(0x42);
+        let id = packet_ids::play::serverbound::SPECTATOR_ACTION;
+        assert_eq!(
+            serverbound(State::Play, id, &w.data, |_| None).unwrap(),
+            Out::Dropped
+        );
+    }
+
+    #[test]
+    fn other_serverbound_packets_are_untouched() {
+        let keep_alive = packet_ids::play::serverbound::KEEP_ALIVE;
+        assert_eq!(
+            serverbound(State::Play, keep_alive, &[0; 8], |_| None).unwrap(),
+            Out::Untouched
+        );
+    }
+}
