+        // Sky mask: sections 0 and 2 (one long, 0b101); block mask: section 9 (bit 9); both empty masks none.
+        for mask in [&[0b101_i64][..], &[1 << 9], &[], &[]] {
+            w.varint(mask.len() as i32);
