+fn respawn(payload: &[u8], version: ServerVersion) -> Result<Vec<u8>> {
+    let mut r = Reader::new(payload);
+    let mut w = Writer::new();
+    play::SpawnInfo::write(&spawn_info(&mut r, version)?, &mut w);
+    w.bytes(r.rest());
+    Ok(w.data)
+}
