+        d::set(&mut out, "FadeColors", Tag::IntArray(value.fade.clone()));
+    }
+    if value.trail {
+        d::set(&mut out, "Trail", Tag::Byte(1));
+    }
+    if value.twinkle {
+        d::set(&mut out, "Flicker", Tag::Byte(1));
+    }
+    out
