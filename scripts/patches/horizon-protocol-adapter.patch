+        w.bytes(&data);
+        w.varint(number(entry.get("ticks_in_hive"), 0));
+        w.varint(number(entry.get("min_ticks_in_hive"), 0));
+    }
+    Ok(Component::Raw(w.data))
+}
+fn legacy_raw(tag: &mut Tag, kind: i32, bytes: &[u8]) -> Result<()> {
