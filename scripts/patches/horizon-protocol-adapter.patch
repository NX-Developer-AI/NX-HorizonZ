+#[derive(Default)]
+pub(crate) struct Metadata {
+    living: HashMap<i32, (i32, bool)>,
+    clouds: HashMap<i32, (i32, Particle)>,
+}
+impl Metadata {
+    pub(crate) fn clear(&mut self) {
+        self.living.clear();
+        self.clouds.clear();
+    }
+    pub(crate) fn forget(&mut self, entity: i32) {
+        self.living.remove(&entity);
+        self.clouds.remove(&entity);
+    }
+}
