+                entity_data(&session, &mut old);
+                let mut expected = metadata(ServerVersion::V1_20_6, new);
+                old.values.sort_by_key(|v| v.0);
+                expected.values.sort_by_key(|v| v.0);
+                assert_eq!(old, expected);
