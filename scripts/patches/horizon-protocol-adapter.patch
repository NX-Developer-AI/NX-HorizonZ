+        }
+        // ItemFrame and BlockDisplay are not LivingEntity: their integer entry must stay an integer.
+        for kind in [74, 15] {
+            session.kinds.lock().unwrap().insert(42, kind);
+            let mut data = play::SetEntityData {
+                id: 42,
