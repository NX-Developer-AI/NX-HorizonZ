@@ -0,0 +1,13 @@
+//! Host/port parser corpus, without DNS or a connection.
+use horizon_protocol::servers::parse_address;
+use std::{error::Error, fs::File};
+
+fn main() -> Result<(), Box<dyn Error>> {
+    let args: Vec<_> = std::env::args().collect();
+    let input = args.get(1).ok_or("expected input and output paths")?;
+    let output = args.get(2).ok_or("expected output path")?;
+    let addresses: Vec<String> = serde_json::from_reader(File::open(input)?)?;
+    let results: Vec<_> = addresses.iter().map(|text| parse_address(text)).collect();
+    serde_json::to_writer(File::create(output)?, &results)?;
+    Ok(())
+}
diff --git a/crates/horizon-protocol/src/adapter.rs b/crates/horizon-protocol/src/adapter.rs
new file mode 100644
index 0000000000..41359e74ee
--- /dev/null
+++ b/crates/horizon-protocol/src/adapter.rs
@@ -0,0 +1,637 @@
+//! Speaking to servers of an older release: the first layer of the native protocol adapter (roadmap
+//! `older-servers`). Horizon's packets are 26.3's; a server on another protocol numbers them differently.
+//! This maps packet ids per connection state, both ways; a [`Session`] follows one connection's states
+//! and renumbers what goes through it. [`ids`] renumbers the registry ids inside packets as the shared
+//! readers decode them, and `translate` rewrites the packets whose layout changed. An older version is
+//! translated a release at a time (26.1 to 26.2, then 26.2 to 26.3), with its ids mapped straight to the
+//! pinned ones. A Horizon server runs the ids the other way for a client of an older release
+//! ([`ClientSession`], roadmap `older-clients`), when its owner lets such clients join.
+pub mod client_session;
+pub mod ids;
+pub mod layout_26_2;
+mod legacy;
+mod pinned_ids;
+pub mod session;
+mod translate;
+pub(crate) use translate::v1_20_2::read_component as read_legacy_component;
+pub mod v1_20_1;
+pub mod v1_20_2;
+mod v1_20_2_ids;
+pub mod v1_20_3;
+mod v1_20_3_ids;
+pub mod v1_20_6;
+mod v1_20_6_ids;
+pub mod v1_21_1;
+pub mod v1_21_10;
+mod v1_21_10_ids;
+pub mod v1_21_11;
+mod v1_21_11_ids;
+mod v1_21_1_ids;
+pub mod v1_21_3;
+mod v1_21_3_ids;
+pub mod v1_21_4;
+mod v1_21_4_ids;
+pub mod v1_21_5;
+mod v1_21_5_ids;
+pub mod v1_21_6;
+mod v1_21_6_ids;
+pub mod v1_21_8;
+mod v1_21_8_ids;
+pub mod v26_1_2;
+mod v26_1_2_ids;
+pub mod v26_2;
+mod v26_2_ids;
+
+pub use client_session::ClientSession;
+pub use session::Session;
+
+use crate::{
+    Direction, Result, State,
+    buf::{Reader, write_varint},
+};
+
+/// The protocol a server speaks.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Hash)]
+pub enum ServerVersion {
+    /// The pinned version ([`crate::PROTOCOL_VERSION`]): nothing to translate.
+    #[default]
+    Current,
+    V26_2,
+    /// 26.1, 26.1.1 and 26.1.2: one protocol.
+    V26_1,
+    V1_21_11,
+    /// 1.21.9 and 1.21.10: one protocol.
+    V1_21_10,
+    /// 1.21.7 and 1.21.8: one protocol.
+    V1_21_8,
+    V1_21_6,
+    V1_21_5,
+    V1_21_4,
+    /// 1.21.2 and 1.21.3: one protocol.
+    V1_21_3,
+    /// 1.21 and 1.21.1: one protocol.
+    V1_21_1,
+    /// 1.20.5 and 1.20.6: one protocol.
+    V1_20_6,
+    /// 1.20.3 and 1.20.4: one protocol.
+    V1_20_3,
+    V1_20_2,
+    V1_20_1,
+}
+
+impl ServerVersion {
+    /// Newest first.
+    pub const ALL: [Self; 15] = [
+        Self::Current,
+        Self::V26_2,
+        Self::V26_1,
+        Self::V1_21_11,
+        Self::V1_21_10,
+        Self::V1_21_8,
+        Self::V1_21_6,
+        Self::V1_21_5,
+        Self::V1_21_4,
+        Self::V1_21_3,
+        Self::V1_21_1,
+        Self::V1_20_6,
+        Self::V1_20_3,
+        Self::V1_20_2,
+        Self::V1_20_1,
+    ];
+
+    /// Whether this is `other` or an older release: the translation steps from `other` up apply.
+    pub fn at_most(self, other: Self) -> bool {
+        let age = |v: Self| Self::ALL.iter().position(|&a| a == v).unwrap_or(0);
+        age(self) >= age(other)
+    }
+
+    /// The protocol number its handshake states.
+    pub fn protocol(self) -> i32 {
+        match self {
+            Self::Current => crate::PROTOCOL_VERSION,
+            Self::V26_2 => v26_2::PROTOCOL,
+            Self::V26_1 => v26_1_2::PROTOCOL,
+            Self::V1_21_11 => v1_21_11::PROTOCOL,
+            Self::V1_21_10 => v1_21_10::PROTOCOL,
+            Self::V1_21_8 => v1_21_8::PROTOCOL,
+            Self::V1_21_6 => v1_21_6::PROTOCOL,
+            Self::V1_21_5 => v1_21_5::PROTOCOL,
+            Self::V1_21_4 => v1_21_4::PROTOCOL,
+            Self::V1_21_3 => v1_21_3::PROTOCOL,
+            Self::V1_21_1 => v1_21_1::PROTOCOL,
+            Self::V1_20_6 => v1_20_6::PROTOCOL,
+            Self::V1_20_3 => v1_20_3::PROTOCOL,
+            Self::V1_20_2 => v1_20_2::PROTOCOL,
+            Self::V1_20_1 => v1_20_1::PROTOCOL,
+        }
+    }
+
+    /// The release name, as a server list shows it.
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::Current => crate::GAME_VERSION,
+            Self::V26_2 => v26_2::NAME,
+            Self::V26_1 => "26.1",
+            Self::V1_21_11 => v1_21_11::NAME,
+            Self::V1_21_10 => "1.21.10",
+            Self::V1_21_8 => v1_21_8::NAME,
+            Self::V1_21_6 => v1_21_6::NAME,
+            Self::V1_21_5 => v1_21_5::NAME,
+            Self::V1_21_4 => v1_21_4::NAME,
+            Self::V1_21_3 => v1_21_3::NAME,
+            Self::V1_21_1 => v1_21_1::NAME,
+            Self::V1_20_6 => v1_20_6::NAME,
+            Self::V1_20_3 => v1_20_3::NAME,
+            Self::V1_20_2 => v1_20_2::NAME,
+            Self::V1_20_1 => v1_20_1::NAME,
+        }
+    }
+
+    /// The version a server's status reports by its protocol number.
+    pub fn from_protocol(protocol: i32) -> Option<Self> {
+        Self::ALL.into_iter().find(|v| v.protocol() == protocol)
+    }
+
+    /// The pinned version's id for a packet this version's server sent as `id`. `None` when the pinned
+    /// version has no such packet.
+    pub fn clientbound_id(self, state: State, id: i32) -> Option<i32> {
+        self.map(state, Direction::Clientbound, id)
+    }
+
+    /// The id this version's server knows a packet Horizon sends as `id` by. `None` when that server has
+    /// no such packet, so it must not be sent.
+    pub fn serverbound_id(self, state: State, id: i32) -> Option<i32> {
+        self.map(state, Direction::Serverbound, id)
+    }
+
+    /// How this version numbers block states and registries, against the pinned one. `None` for the pinned
+    /// version itself.
+    pub fn ids(self) -> Option<&'static ids::Ids> {
+        // Before 26.3 a tag slot display was a bare tag id, and pot decorations were item ids.
+        const BEFORE_26_3: ids::Quirks = ids::Quirks {
+            tag_slot_display_is_id: true,
+            pot_decorations_are_items: true,
+            ..ids::Quirks::NONE
+        };
+        // Before 26.1 registry entries in components were EitherHolders, damage resistance a tag,
+        // and components held ItemStacks rather than templates.
+        const BEFORE_26_1: ids::Quirks = ids::Quirks {
+            either_holders_and_tag_resistance: true,
+            stacks_in_components: true,
+            ..BEFORE_26_3
+        };
+        static V26_2: ids::Ids = ids::Ids {
+            quirks: BEFORE_26_3,
+            ..v26_2_ids::IDS
+        };
+        static V26_1: ids::Ids = ids::Ids {
+            quirks: BEFORE_26_3,
+            ..v26_1_2_ids::IDS
+        };
+        static V1_21_11: ids::Ids = ids::Ids {
+            quirks: BEFORE_26_1,
+            // 26.1 registered the cat, cow, pig and chicken sound variants among the others.
+            entity_data_serializer: ids::Remap::Runs {
+                up: &[
+                    (0, 0, 22),
+                    (22, 23, 1),
+                    (23, 25, 4),
+                    (27, 30, 1),
+                    (28, 32, 11),
+                ],
+                down: &[
+                    (0, 0, 22),
+                    (23, 22, 1),
+                    (25, 23, 4),
+                    (30, 27, 1),
+                    (32, 28, 11),
+                ],
+            },
+            ..v1_21_11_ids::IDS
+        };
+        static V1_21_10: ids::Ids = ids::Ids {
+            quirks: BEFORE_26_1,
+            // As 1.21.11's, without the zombie nautilus variant 1.21.11 added after the chicken's.
+            entity_data_serializer: ids::Remap::Runs {
+                up: &[
+                    (0, 0, 22),
+                    (22, 23, 1),
+                    (23, 25, 4),
+                    (27, 30, 1),
+                    (28, 33, 9),
+                ],
+                down: &[
+                    (0, 0, 22),
+                    (23, 22, 1),
+                    (25, 23, 4),
+                    (30, 27, 1),
+                    (33, 28, 9),
+                ],
+            },
+            ..v1_21_10_ids::IDS
+        };
+        static V1_21_8: ids::Ids = ids::Ids {
+            quirks: ids::Quirks {
+                shoulder_parrots_as_nbt: true,
+                count_first_templates: true,
+                optional_profile_fields: true,
+                simple_spell_particles: true,
+                ..BEFORE_26_1
+            },
+            // EntityDataSerializers in 1.21.8's registration order: compound tags (16) went away;
+            // the later sound variants, copper golem states and profile serializers were added.
+            entity_data_serializer: ids::Remap::Runs {
+                up: &[
+                    (0, 0, 16),
+                    (17, 16, 6),
+                    (23, 23, 1),
+                    (24, 25, 4),
+                    (28, 30, 1),
+                    (29, 33, 4),
+                    (33, 39, 2),
+                ],
+                down: &[
+                    (0, 0, 16),
+                    (16, 17, 6),
+                    (23, 23, 1),
+                    (25, 24, 4),
+                    (30, 28, 1),
+                    (33, 29, 4),
+                    (39, 33, 2),
+                ],
+            },
+            ..v1_21_8_ids::IDS
+        };
+        static V1_21_6: ids::Ids = ids::Ids {
+            // The same layouts and metadata serializers, with the item/sound numbering before
+            // 1.21.7 added the lava chicken disc. Other registries are shared by generated tables.
+            quirks: V1_21_8.quirks,
+            entity_data_serializer: V1_21_8.entity_data_serializer,
+            ..v1_21_6_ids::IDS
+        };
+        static V1_21_5: ids::Ids = ids::Ids {
+            quirks: ids::Quirks {
+                components_before_1_21_6: true,
+                ..V1_21_8.quirks
+            },
+            entity_data_serializer: V1_21_8.entity_data_serializer,
+            ..v1_21_5_ids::IDS
+        };
+        static V1_21_4: ids::Ids = ids::Ids {
+            quirks: ids::Quirks {
+                wolf_variant_holder: true,
+                components_before_1_21_5: true,
+                ..V1_21_5.quirks
+            },
+            // Vanilla EntityDataSerializers' registration order (not their declaration order).
