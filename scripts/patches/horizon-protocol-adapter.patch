@@ -0,0 +1,441 @@
+use super::*;
+use crate::adapter::v1_20_2_ids;
+use horizon_world::nbt::Tag;
+use packet_ids::configuration::clientbound as configuration_clientbound;
+use packet_ids::configuration::serverbound as configuration_serverbound;
+
+const SPAWN_PLAYER: i32 = 3;
+const SPAWN_ENTITY: i32 = 1;
+const CUSTOM_PAYLOAD: i32 = 23;
+const DISCONNECT: i32 = 26;
+const KEEP_ALIVE: i32 = 35;
+const LOGIN: i32 = 40;
+const PING: i32 = 50;
+const FEATURE_FLAGS: i32 = 107;
+pub(crate) const RECIPE_BOOK: i32 = 61;
+
+struct Join {
+    registries: Tag,
+    login: Vec<u8>,
+}
+
+#[derive(Default)]
+pub(crate) struct Configuration {
+    join: Option<Join>,
+    early: Vec<(i32, Vec<u8>)>,
+    pending: Vec<Vec<u8>>,
+}
+
+pub(crate) enum Raw {
+    Packet(i32, Vec<u8>),
+    Done(Option<(i32, Vec<u8>)>),
+}
+
+pub(crate) fn before_mapping(
+    session: &Session,
+    state: State,
+    id: i32,
+    payload: Vec<u8>,
+) -> Result<Raw> {
+    match state {
+        State::Play if id == SPAWN_PLAYER => Ok(Raw::Packet(SPAWN_ENTITY, spawn_player(&payload)?)),
+        State::Play if id == LOGIN => Ok(Raw::Packet(LOGIN, join(&payload)?.login)),
+        State::Configuration => configuration(session, id, payload).map(Raw::Done),
+        _ => Ok(Raw::Packet(id, payload)),
+    }
+}
+
+fn configuration(session: &Session, id: i32, payload: Vec<u8>) -> Result<Option<(i32, Vec<u8>)>> {
+    let mut configuration = session.legacy_configuration.lock().unwrap();
+    if id == LOGIN {
+        configuration.join = Some(join(&payload)?);
+        return Ok(None);
+    }
+    let Some(join) = configuration.join.take() else {
+        let pinned = match id {
+            KEEP_ALIVE => configuration_clientbound::KEEP_ALIVE,
+            DISCONNECT => configuration_clientbound::DISCONNECT,
+            CUSTOM_PAYLOAD => configuration_clientbound::CUSTOM_PAYLOAD,
+            PING => configuration_clientbound::PING,
+            _ => {
+                configuration.early.push((id, payload));
+                return Ok(None);
+            }
+        };
+        drop(configuration);
+        return session.clientbound_pinned(State::Configuration, pinned, payload);
+    };
+    let early = std::mem::take(&mut configuration.early);
+    drop(configuration);
+    let (features, current) = if id == FEATURE_FLAGS {
+        (payload, None)
+    } else {
+        (vanilla_features(), Some((id, payload)))
+    };
+    finish(session, join, features, early, current)
+}
+
+fn finish(
+    session: &Session,
+    join: Join,
+    features: Vec<u8>,
+    early: Vec<(i32, Vec<u8>)>,
+    current: Option<(i32, Vec<u8>)>,
+) -> Result<Option<(i32, Vec<u8>)>> {
+    let mut packets = Vec::new();
+    let mut registries = Writer::new();
+    registries.nbt(&join.registries);
+    for (pinned, body) in [
+        (configuration_clientbound::UPDATE_ENABLED_FEATURES, features),
+        (configuration_clientbound::REGISTRY_DATA, registries.data),
+        (configuration_clientbound::FINISH_CONFIGURATION, Vec::new()),
+    ] {
+        let result = session.clientbound_pinned(State::Configuration, pinned, body)?;
+        collect(session, &mut packets, result);
+    }
+    session.set_reading(State::Play);
+    let result = session.clientbound(LOGIN, join.login)?;
+    collect(session, &mut packets, result);
+    for (id, payload) in early.into_iter().chain(current) {
+        let result = session.clientbound(id, payload)?;
+        collect(session, &mut packets, result);
+    }
+    let mut packets = packets.into_iter();
+    let first = packets.next();
+    session.incoming.lock().unwrap().extend(packets);
+    Ok(first)
+}
+
+fn collect(session: &Session, packets: &mut Vec<(i32, Vec<u8>)>, result: Option<(i32, Vec<u8>)>) {
+    packets.extend(result);
+    packets.extend(session.incoming.lock().unwrap().drain(..));
+}
+
+fn vanilla_features() -> Vec<u8> {
+    let mut w = Writer::new();
+    w.varint(1);
+    w.string("minecraft:vanilla");
+    w.data
+}
+
+fn join(payload: &[u8]) -> Result<Join> {
+    let mut r = Reader::new(payload);
+    let entity = r.i32()?;
+    let hardcore = r.bool()?;
+    let game_type = r.u8()?;
+    let previous_game_type = r.i8()?;
+    let count = r.count(r.remaining())?;
+    let mut dimensions = Vec::with_capacity(count.min(64));
+    for _ in 0..count {
+        dimensions.push(r.string(32767)?);
+    }
+    let registries = r.named_nbt()?;
+    let dimension_type = r.string(32767)?;
+    let dimension = r.string(32767)?;
+    let seed = r.i64()?;
+    let max_players = r.varint()?;
+    let view_distance = r.varint()?;
+    let simulation_distance = r.varint()?;
+    let reduced_debug_info = r.bool()?;
+    let respawn_screen = r.bool()?;
+    let debug = r.bool()?;
+    let flat = r.bool()?;
+    let death = death_location(&mut r)?;
+    let portal_cooldown = r.varint()?;
+    finish_reading(&r)?;
+    let mut w = Writer::new();
+    w.i32(entity);
+    w.bool(hardcore);
+    w.varint(dimensions.len() as i32);
+    for name in &dimensions {
+        w.string(name);
+    }
+    w.varint(max_players);
+    w.varint(view_distance);
+    w.varint(simulation_distance);
+    w.bool(reduced_debug_info);
+    w.bool(respawn_screen);
+    w.bool(false);
+    w.string(&dimension_type);
+    w.string(&dimension);
+    w.i64(seed);
+    w.u8(game_type);
+    w.i8(previous_game_type);
+    w.bool(debug);
+    w.bool(flat);
+    write_death_location(&mut w, death);
+    w.varint(portal_cooldown);
+    Ok(Join {
+        registries,
+        login: w.data,
+    })
+}
+
+fn death_location(r: &mut Reader) -> Result<Option<(String, i64)>> {
+    if r.bool()? {
+        Ok(Some((r.string(32767)?, r.i64()?)))
+    } else {
+        Ok(None)
+    }
+}
+
+fn write_death_location(w: &mut Writer, death: Option<(String, i64)>) {
+    match death {
+        Some((dimension, position)) => {
+            w.bool(true);
+            w.string(&dimension);
+            w.i64(position);
+        }
+        None => w.bool(false),
+    }
+}
+
+fn finish_reading(r: &Reader) -> Result<()> {
+    if r.remaining() == 0 {
+        Ok(())
+    } else {
+        Err(crate::Error::new("trailing 1.20.1 packet bytes"))
+    }
+}
+
+fn spawn_player(payload: &[u8]) -> Result<Vec<u8>> {
+    let player = v1_20_2_ids::ENTITY_TYPE_NAMES
+        .iter()
+        .position(|name| *name == "minecraft:player")
+        .ok_or_else(|| crate::Error::new("missing 1.20.1 player entity type"))?;
+    let mut r = Reader::new(payload);
+    let entity = r.varint()?;
+    let uuid = r.uuid()?;
+    let position = [r.f64()?, r.f64()?, r.f64()?];
+    let yaw = r.u8()?;
+    let pitch = r.u8()?;
+    finish_reading(&r)?;
+    let mut w = Writer::new();
+    w.varint(entity);
+    w.uuid(uuid);
+    w.varint(player as i32);
+    for coordinate in position {
+        w.f64(coordinate);
+    }
+    w.u8(pitch);
+    w.u8(yaw);
+    w.u8(yaw);
+    w.varint(0);
+    for _ in 0..3 {
+        w.i16(0);
+    }
+    Ok(w.data)
+}
+
+pub(super) fn clientbound(
+    _session: &Session,
+    state: State,
+    id: i32,
+    payload: &[u8],
+) -> Result<Option<Vec<u8>>> {
+    use packet_ids::play::clientbound as cb;
+    if state != State::Play {
+        return Ok(None);
+    }
+    match id {
+        cb::FORGET_LEVEL_CHUNK => forget_chunk(payload).map(Some),
+        cb::RESPAWN => respawn(payload).map(Some),
+        cb::LEVEL_CHUNK_WITH_LIGHT => chunk(payload).map(Some),
+        cb::BLOCK_ENTITY_DATA => block_entity_data(payload).map(Some),
+        cb::TAG_QUERY => tag_query(payload).map(Some),
+        cb::UPDATE_MOB_EFFECT => mob_effect(payload).map(Some),
+        cb::UPDATE_ADVANCEMENTS => advancements(payload).map(Some),
+        _ => Ok(None),
+    }
+}
+
+fn forget_chunk(payload: &[u8]) -> Result<Vec<u8>> {
+    let mut r = Reader::new(payload);
+    let x = r.i32()?;
+    let z = r.i32()?;
+    finish_reading(&r)?;
+    let mut w = Writer::new();
+    w.i32(z);
+    w.i32(x);
+    Ok(w.data)
+}
+
+fn respawn(payload: &[u8]) -> Result<Vec<u8>> {
+    let mut r = Reader::new(payload);
+    let mut w = Writer::new();
+    w.string(&r.string(32767)?);
+    w.string(&r.string(32767)?);
+    w.i64(r.i64()?);
+    w.u8(r.u8()?);
+    w.i8(r.i8()?);
+    w.bool(r.bool()?);
+    w.bool(r.bool()?);
+    let kept = r.u8()?;
+    let death = death_location(&mut r)?;
+    write_death_location(&mut w, death);
+    w.varint(r.varint()?);
+    finish_reading(&r)?;
+    w.u8(kept);
+    Ok(w.data)
+}
+
+fn chunk(payload: &[u8]) -> Result<Vec<u8>> {
+    let mut r = Reader::new(payload);
+    let mut w = Writer::new();
+    w.i32(r.i32()?);
+    w.i32(r.i32()?);
+    w.nbt(&r.named_nbt()?);
+    let size = r.count(r.remaining())?;
+    w.varint(size as i32);
+    w.bytes(r.bytes(size)?);
+    let block_entities = r.count(r.remaining())?;
+    w.varint(block_entities as i32);
+    for _ in 0..block_entities {
+        w.u8(r.u8()?);
+        w.i16(r.i16()?);
+        w.varint(r.varint()?);
+        w.nbt(&r.named_nbt()?);
+    }
+    w.bytes(r.rest());
+    Ok(w.data)
+}
+
+fn block_entity_data(payload: &[u8]) -> Result<Vec<u8>> {
+    let mut r = Reader::new(payload);
+    let mut w = Writer::new();
+    w.i64(r.i64()?);
+    w.varint(r.varint()?);
+    w.nbt(&r.named_nbt()?);
+    finish_reading(&r)?;
+    Ok(w.data)
+}
+
+fn tag_query(payload: &[u8]) -> Result<Vec<u8>> {
+    let mut r = Reader::new(payload);
+    let mut w = Writer::new();
+    w.varint(r.varint()?);
+    w.nbt(&r.named_nbt()?);
+    finish_reading(&r)?;
+    Ok(w.data)
+}
+
+fn mob_effect(payload: &[u8]) -> Result<Vec<u8>> {
+    let mut r = Reader::new(payload);
+    let mut w = Writer::new();
+    w.varint(r.varint()?);
+    w.varint(r.varint()?);
+    w.i8(r.i8()?);
+    w.varint(r.varint()?);
+    w.i8(r.i8()?);
+    let factor = r.bool()?;
+    w.bool(factor);
+    if factor {
+        w.nbt(&r.named_nbt()?);
+    }
+    finish_reading(&r)?;
+    Ok(w.data)
+}
+
+fn advancements(payload: &[u8]) -> Result<Vec<u8>> {
+    let mut r = Reader::new(payload);
+    let mut w = Writer::new();
+    w.bool(r.bool()?);
+    let count = r.count(r.remaining())?;
+    w.varint(count as i32);
+    for _ in 0..count {
+        w.string(&r.string(32767)?);
+        let parent = r.bool()?;
+        w.bool(parent);
+        if parent {
+            w.string(&r.string(32767)?);
+        }
+        let display = r.bool()?;
+        w.bool(display);
+        if display {
+            w.string(&r.string(262144)?);
+            w.string(&r.string(262144)?);
+            let present = r.bool()?;
+            w.bool(present);
+            if present {
+                w.varint(r.varint()?);
+                w.i8(r.i8()?);
+                w.named_nbt(&r.named_nbt()?);
+            }
+            w.varint(r.varint()?);
+            let flags = r.i32()?;
+            w.i32(flags);
+            if flags & 1 != 0 {
+                w.string(&r.string(32767)?);
+            }
+            w.f32(r.f32()?);
+            w.f32(r.f32()?);
+        }
+        let criteria = r.count(r.remaining())?;
+        for _ in 0..criteria {
+            r.string(32767)?;
+        }
+        let requirements = r.count(r.remaining())?;
+        w.varint(requirements as i32);
+        for _ in 0..requirements {
+            let alternatives = r.count(r.remaining())?;
+            w.varint(alternatives as i32);
+            for _ in 0..alternatives {
+                w.string(&r.string(32767)?);
+            }
+        }
+        w.bool(r.bool()?);
+    }
+    w.bytes(r.rest());
+    Ok(w.data)
+}
+
+pub(crate) fn hello(payload: &[u8]) -> Result<Vec<u8>> {
+    let mut r = Reader::new(payload);
+    let name = r.string(16)?;
+    let uuid = r.uuid()?;
+    let mut w = Writer::new();
+    w.varint(packet_ids::login::serverbound::HELLO);
+    w.string(&name);
+    w.bool(true);
+    w.uuid(uuid);
+    Ok(w.data)
+}
+
+pub(crate) fn configuration_serverbound(
+    session: &Session,
+    id: i32,
+    payload: &[u8],
+) -> Result<Option<Vec<u8>>> {
+    use packet_ids::play::serverbound as sb;
+    let (play_id, immediate) = match id {
+        configuration_serverbound::CLIENT_INFORMATION => (sb::CLIENT_INFORMATION, false),
+        configuration_serverbound::CUSTOM_PAYLOAD => (sb::CUSTOM_PAYLOAD, false),
+        configuration_serverbound::KEEP_ALIVE => (sb::KEEP_ALIVE, true),
+        configuration_serverbound::PONG => (sb::PONG, true),
+        configuration_serverbound::RESOURCE_PACK => (sb::RESOURCE_PACK, true),
+        configuration_serverbound::FINISH_CONFIGURATION => {
+            session.set_writing(State::Play);
+            let pending = std::mem::take(&mut session.legacy_configuration.lock().unwrap().pending);
+            session.outgoing.lock().unwrap().extend(pending);
+            return Ok(None);
+        }
+        _ => return Ok(None),
+    };
+    let Some((mapped, body)) = serverbound(session, State::Play, play_id, payload)? else {
+        return Ok(None);
+    };
+    let mut w = Writer::new();
+    w.varint(mapped);
+    w.bytes(&body);
+    if immediate {
+        Ok(Some(w.data))
+    } else {
+        session
+            .legacy_configuration
+            .lock()
+            .unwrap()
+            .pending
+            .push(w.data);
+        Ok(None)
+    }
+}
