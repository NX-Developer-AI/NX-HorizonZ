--- /dev/null
+++ b/crates/horizon-protocol/src/menu_extra.rs
@@ -0,0 +1,232 @@
+//! Menu extra data: what a Horizon server tells a Horizon client about a
+//! native mod's menu type its block opened, just before the
+//! `ClientboundOpenScreenPacket` of the same window (docs/native-mods.md,
+//! "Menu extra data"). NeoForge's counterpart is `openMenu` with an extra-data
+//! writer, read by the menu type's `IContainerFactory`.
+//!
+//! A payload is the window id, the block's position if there is one (a
+//! boolean, then the three axes), then the bytes the mod wrote (empty when it
+//! wrote none). Clientbound only.
+//!
+//! **Revision** (configuration, both directions): before play, the server
+//! sends a client whose `minecraft:brand` is Horizon's [`query`]
+//! (`[QUERY, REVISION]`). A client that knows this revision answers with
+//! [`answer`] (`[ANSWER, REVISION]`); the server sends it the layout above.
+//! A client that answers nothing (an older Horizon build) is sent
+//! [`encode_legacy`]'s layout instead (the window, then the three axes —
+//! never `None` — then the bytes), and no menu is opened without a block
+//! for it. A vanilla client is never asked.
+use crate::{
+    Error, Result,
+    buf::{Reader, Writer},
+};
+
+/// The custom payload channel.
+pub const CHANNEL: &str = "horizon:menu_extra";
+/// The payload layout's revision: a boolean, then optionally the axes.
+pub const REVISION: u8 = 1;
+/// Bytes a mod may write at most.
+pub const MAX_DATA: usize = 32_768;
+
+const QUERY: u8 = 0;
+const ANSWER: u8 = 1;
+
+/// The server's query, configuration clientbound: the custom payload's data.
+pub fn query() -> Vec<u8> {
+    vec![QUERY, REVISION]
+}
+
+/// Reads the server's query. A query of another revision is still answered
+/// (with this one's), so its bytes after the revision are not read.
+pub fn read_query(data: &[u8]) -> Result<()> {
+    let mut r = Reader::new(data);
+    if r.u8()? != QUERY {
+        return Err(Error::new("menu extra revision: not a query"));
+    }
+    if r.u8()? == REVISION && r.remaining() > 0 {
+        return Err(Error::new("menu extra revision: trailing bytes"));
+    }
+    Ok(())
+}
+
+/// The client's answer, configuration serverbound: it reads this revision's layout.
+pub fn answer() -> Vec<u8> {
+    vec![ANSWER, REVISION]
+}
+
+/// Reads a client's answer: the revision whose layout it reads, 0 for one of
+/// another revision (an older build: the legacy layout). Its bytes after the
+/// revision are not read.
+pub fn read_answer(data: &[u8]) -> Result<u8> {
+    let mut r = Reader::new(data);
+    if r.u8()? != ANSWER {
+        return Err(Error::new("menu extra revision: not an answer"));
+    }
+    if r.u8()? != REVISION {
+        return Ok(0);
+    }
+    if r.remaining() > 0 {
+        return Err(Error::new("menu extra revision: trailing bytes"));
+    }
+    Ok(REVISION)
+}
+
+/// A menu's extra data as it travels.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Message {
+    /// The window id the `OpenScreen` that follows carries.
+    pub window: i32,
+    /// The block that opened the menu; None for a menu opened without one.
+    pub pos: Option<[i32; 3]>,
+    pub data: Vec<u8>,
+}
+
+/// A message's payload; an error for data past [`MAX_DATA`].
+pub fn encode(message: &Message) -> Result<Vec<u8>> {
+    if message.data.len() > MAX_DATA {
+        return Err(Error::new("menu extra: data too big"));
+    }
+    let mut w = Writer::new();
+    w.varint(message.window);
+    w.bool(message.pos.is_some());
+    message.pos.iter().flatten().for_each(|&axis| w.i32(axis));
+    w.byte_array(&message.data);
+    Ok(w.data)
+}
+
+/// The legacy layout, for a Horizon client that answered no revision query:
+/// the window, then the block's position (always there), then the bytes.
+/// An error for data past [`MAX_DATA`] or a menu with no block, which such
+/// a client is never sent.
+pub fn encode_legacy(message: &Message) -> Result<Vec<u8>> {
+    let Some([x, y, z]) = message.pos else {
+        return Err(Error::new("menu extra: legacy payload needs a position"));
+    };
+    if message.data.len() > MAX_DATA {
+        return Err(Error::new("menu extra: data too big"));
+    }
+    let mut w = Writer::new();
+    w.varint(message.window);
+    w.i32(x);
+    w.i32(y);
+    w.i32(z);
+    w.byte_array(&message.data);
+    Ok(w.data)
+}
+
+/// A payload's message; an error for one that breaks a cap. The layout a
+/// client that answered the revision query reads.
+pub fn decode(data: &[u8]) -> Result<Message> {
+    let mut r = Reader::new(data);
+    let window = r.varint()?;
+    let pos = if r.bool()? {
+        Some([r.i32()?, r.i32()?, r.i32()?])
+    } else {
+        None
+    };
+    let data = r.byte_array(MAX_DATA)?;
+    if r.remaining() > 0 {
+        return Err(Error::new("menu extra: trailing bytes"));
+    }
+    Ok(Message { window, pos, data })
+}
+
+/// A payload's message in the legacy layout, as an older Horizon client sends
+/// or expects it: the window, the block's position, then the bytes.
+pub fn decode_legacy(data: &[u8]) -> Result<Message> {
+    let mut r = Reader::new(data);
+    let window = r.varint()?;
+    let pos = Some([r.i32()?, r.i32()?, r.i32()?]);
+    let data = r.byte_array(MAX_DATA)?;
+    if r.remaining() > 0 {
+        return Err(Error::new("menu extra: trailing bytes"));
+    }
+    Ok(Message { window, pos, data })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_message_round_trips() {
+        for (pos, data) in [
+            (Some([-30_000_000, -64, 29_999_999]), vec![]),
+            (Some([0, 0, 0]), vec![0, 255, 7]),
+            (None, vec![9; MAX_DATA]),
+            (None, vec![1, 2, 3]),
+        ] {
+            let m = Message {
+                window: 100,
+                pos,
+                data,
+            };
+            assert_eq!(decode(&encode(&m).unwrap()).unwrap(), m);
+        }
+    }
+
+    #[test]
+    fn caps_are_enforced_both_ways() {
+        let big = Message {
+            window: 1,
+            pos: Some([0; 3]),
+            data: vec![0; MAX_DATA + 1],
+        };
+        assert!(encode(&big).is_err());
+        // Built by hand, as a server that skipped the check would.
+        let mut w = Writer::new();
+        w.varint(1);
+        w.bool(false);
+        w.byte_array(&vec![0; MAX_DATA + 1]);
+        assert!(decode(&w.data).is_err());
+        let mut ok = encode(&Message {
+            window: 1,
+            pos: Some([0; 3]),
+            data: vec![1],
+        })
+        .unwrap();
+        ok.push(0);
+        assert!(decode(&ok).is_err(), "trailing bytes");
+        assert!(decode(&[]).is_err());
+        assert!(decode(&[1, 1, 0]).is_err(), "a cut position");
+    }
+
+    #[test]
+    fn the_revision_exchange_round_trips() {
+        assert_eq!(read_query(&query()).unwrap(), ());
+        assert_eq!(read_answer(&answer()).unwrap(), REVISION);
+        // Another revision's exchange is still answered, and reads as none.
+        let other = [QUERY, REVISION + 1, 9];
+        assert_eq!(read_query(&other).unwrap(), ());
+        let answer_of_another = [ANSWER, REVISION + 1, 9];
+        assert_eq!(read_answer(&answer_of_another).unwrap(), 0);
+        assert!(read_query(&[ANSWER, REVISION]).is_err());
+        assert!(read_answer(&[QUERY, REVISION]).is_err());
+        assert!(read_query(&[QUERY, REVISION, 0]).is_err(), "trailing bytes");
+        assert!(read_query(&[]).is_err());
+    }
+
+    #[test]
+    fn the_legacy_layout_round_trips_and_refuses_none() {
+        let m = Message {
+            window: 4,
+            pos: Some([3, 70, -5]),
+            data: vec![1, 2, 3],
+        };
+        assert_eq!(decode_legacy(&encode_legacy(&m).unwrap()).unwrap(), m);
+        // A legacy payload is not this revision's layout.
+        assert!(decode(&encode_legacy(&m).unwrap()).is_err());
+        assert!(decode_legacy(&encode(&m).unwrap()).is_err());
+        // A client that reads the legacy layout is never sent a blockless menu.
+        let blockless = Message {
+            pos: None,
+            ..m.clone()
+        };
+        assert!(encode_legacy(&blockless).is_err());
+        let big = Message {
+            data: vec![0; MAX_DATA + 1],
+            ..m
+        };
+        assert!(encode_legacy(&big).is_err());
+    }
+}
diff --git a/crates/horizon-protocol/src/mod_list.rs b/crates/horizon-protocol/src/mod_list.rs
new file mode 100644
index 0000000000..57213b7e69
--- /dev/null
+++ b/crates/horizon-protocol/src/mod_list.rs
@@ -0,0 +1,274 @@
+//! Configuration-phase mod compatibility. Only both-side ids and versions cross
+//! [`CHANNEL`]; client-only and server-only mods stay private. Content identity
+//! is checked separately. A vanilla client never hears the channel.
+use crate::{
+    Error, Result,
+    buf::{Reader, Writer},
+};
+use std::sync::OnceLock;
+
+/// The custom payload channel, both ways.
+pub const CHANNEL: &str = "horizon:mod_list";
+/// Mods in a list at most; a list with more is refused whole.
+pub const MAX_ENTRIES: usize = 128;
+/// Characters in a mod's id or version at most.
+pub const MAX_TEXT: usize = 64;
+
+/// Where a mod runs (a manifest's `side`).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Side {
+    /// Both halves must have it: it changes what the world holds.
+    Both,
+    /// Only the server needs it.
+    Server,
+    /// Only the player's game: a HUD, keys, a minimap. Any server accepts it.
+    Client,
+}
+
+/// A mod that is on.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Entry {
+    pub id: String,
+    pub version: String,
+    pub side: Side,
+}
+
+/// The mods this game has on, set once when they load (`game/modding/mods/mod.rs`), like
+/// the registries they fill, and read when a connection is set up, whatever
+/// side of it this game is.
+static LOCAL: OnceLock<Vec<Entry>> = OnceLock::new();
+
+/// Sets the mods this game has on; false when they were set already (a pack
+/// reload builds another root, the registries keep the first).
+pub fn set_local(mut entries: Vec<Entry>) -> bool {
+    entries.sort_by(|a, b| a.id.cmp(&b.id));
+    LOCAL.set(entries).is_ok()
+}
+
+/// Whether `set_local` has run: a pack reload keeps the first list.
+pub fn is_set() -> bool {
+    LOCAL.get().is_some()
+}
+
+/// The mods this game has on, by id.
+pub fn local() -> Vec<Entry> {
+    LOCAL.get().cloned().unwrap_or_default()
+}
+
+/// Both-side ids and versions as a payload. Never truncate an identity or list:
+/// the receiver refuses an oversized list rather than comparing a partial one.
+pub fn encode(entries: &[Entry]) -> Vec<u8> {
+    let shared: Vec<_> = entries.iter().filter(|e| e.side == Side::Both).collect();
+    let mut w = Writer::new();
+    w.varint(shared.len() as i32);
+    for e in shared {
+        w.string(&e.id);
+        w.string(&e.version);
+    }
+    w.data
+}
+
+/// A payload's list; an error for one that breaks a cap.
+pub fn decode(data: &[u8]) -> Result<Vec<Entry>> {
+    let mut r = Reader::new(data);
+    let count = r.varint()?;
+    if !(0..=MAX_ENTRIES as i32).contains(&count) {
+        return Err(Error::new(format!("mod list: {count} mods")));
+    }
+    let mut ids = std::collections::BTreeSet::new();
+    let entries = (0..count)
+        .map(|_| {
+            let id = r.string(MAX_TEXT)?;
+            let version = r.string(MAX_TEXT)?;
+            if id.is_empty() || version.is_empty() || !ids.insert(id.clone()) {
+                return Err(Error::new("mod list: empty identity or duplicate id"));
+            }
+            Ok(Entry {
+                id,
+                version,
+                side: Side::Both,
+            })
+        })
+        .collect::<Result<Vec<_>>>()?;
+    if r.remaining() > 0 {
+        return Err(Error::new("mod list: trailing bytes"));
+    }
+    Ok(entries)
+}
+
+/// How a client's mods differ from a server's.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Difference {
+    /// The server has it on and the client does not: `id version`.
+    pub missing: Vec<String>,
+    /// The client has it on, the server does not, and it changes the world.
+    pub extra: Vec<String>,
+    /// Both have it, at different versions.
+    pub changed: Vec<VersionDifference>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct VersionDifference {
+    pub id: String,
+    pub server: String,
+    pub client: String,
+}
+
+impl Difference {
+    pub fn is_empty(&self) -> bool {
+        self.missing.is_empty() && self.extra.is_empty() && self.changed.is_empty()
+    }
+}
+
+/// What a client must change to join a server. Only `Both` mods count, on
+/// either side: a `Server` mod is the server's business, a `Client` one the
+/// player's.
+pub fn compare(server: &[Entry], client: &[Entry]) -> Difference {
+    let mut difference = Difference::default();
+    for s in server.iter().filter(|s| s.side == Side::Both) {
+        match client.iter().find(|c| c.side == Side::Both && c.id == s.id) {
+            None => difference.missing.push(format!("{} {}", s.id, s.version)),
+            Some(c) if s.version != c.version => difference.changed.push(VersionDifference {
+                id: s.id.clone(),
+                server: s.version.clone(),
+                client: c.version.clone(),
+            }),
+            Some(_) => {}
+        }
+    }
+    for c in client.iter().filter(|c| c.side == Side::Both) {
+        if !server.iter().any(|s| s.side == Side::Both && s.id == c.id) {
+            difference.extra.push(format!("{} {}", c.id, c.version));
+        }
+    }
+    difference
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn entry(id: &str, version: &str, side: Side) -> Entry {
+        Entry {
+            id: id.into(),
+            version: version.into(),
+            side,
+        }
+    }
+
+    #[test]
+    fn only_shared_mods_are_sent() {
+        let list = [
+            entry("ruby", "1.0", Side::Both),
+            entry("minimap", "2.0", Side::Client),
+            entry("admin", "3.0", Side::Server),
+        ];
+        let sent = decode(&encode(&list)).unwrap();
+        assert_eq!(sent.len(), 1);
+        assert_eq!(sent[0].id, "ruby");
+        assert!(compare(&list, &sent).is_empty());
+    }
+
+    #[test]
+    fn a_list_round_trips() {
+        let list = vec![entry("ruby", "1.2.0", Side::Both)];
+        assert_eq!(decode(&encode(&list)).unwrap(), list);
+        assert_eq!(decode(&encode(&[])).unwrap(), []);
+    }
+
+    #[test]
+    fn lists_over_the_caps_are_refused() {
+        let mut w = Writer::new();
+        w.varint(MAX_ENTRIES as i32 + 1);
+        assert!(decode(&w.data).is_err());
+        let mut w = Writer::new();
+        w.varint(1);
+        w.string(&"x".repeat(MAX_TEXT + 1));
+        assert!(decode(&w.data).is_err());
+        let mut w = Writer::new();
+        w.varint(1);
+        w.string("a");
+        w.string("");
+        assert!(decode(&w.data).is_err());
+        let duplicate = entry("a", "1", Side::Both);
+        assert!(decode(&encode(&[duplicate.clone(), duplicate])).is_err());
+        let mut trailing = encode(&[]);
+        trailing.push(0);
+        assert!(decode(&trailing).is_err());
+        assert!(decode(&[0xFF]).is_err());
+    }
+
+    #[test]
+    fn the_same_mods_match_whatever_the_order() {
+        let a = entry("a", "1", Side::Both);
+        let b = entry("b", "2", Side::Both);
+        assert!(compare(&[a.clone(), b.clone()], &[b, a]).is_empty());
+    }
+
+    #[test]
+    fn each_kind_of_difference_is_named() {
+        let server = [
+            entry("ruby", "1.0", Side::Both),
+            entry("pipes", "2.0", Side::Both),
+            entry("glass", "1.0", Side::Both),
+        ];
+        let client = [
+            entry("ruby", "1.0", Side::Both),
+            entry("pipes", "2.0", Side::Both),
+            entry("glass", "0.9", Side::Both),
+            entry("xray_blocks", "1.0", Side::Both),
+        ];
+        let d = compare(&server, &client);
+        assert_eq!(d.missing, Vec::<String>::new());
+        assert_eq!(d.extra, ["xray_blocks 1.0"]);
+        assert_eq!(d.changed.len(), 1);
+        assert_eq!(d.changed[0].id, "glass");
+        assert_eq!(d.changed[0].server, "1.0");
+        assert_eq!(d.changed[0].client, "0.9");
+        let d = compare(&server, &client[..1]);
+        assert_eq!(d.missing, ["pipes 2.0", "glass 1.0"]);
+    }
+
+    #[test]
+    fn client_only_and_server_only_mods_never_block_a_join() {
+        let server = [
+            entry("anti_grief", "1", Side::Server),
+            entry("ruby", "1", Side::Both),
+        ];
+        let client = [
+            entry("minimap", "3", Side::Client),
+            entry("ruby", "1", Side::Both),
+        ];
+        assert!(compare(&server, &client).is_empty());
+        assert!(compare(&[], &[entry("minimap", "3", Side::Client)]).is_empty());
+    }
+
+    #[test]
+    fn a_client_only_identity_cannot_satisfy_a_both_side_requirement() {
+        assert_eq!(
+            compare(
+                &[entry("ruby", "1", Side::Both)],
+                &[entry("ruby", "1", Side::Client)]
+            )
+            .missing,
+            ["ruby 1"]
+        );
+        assert_eq!(
+            compare(&[], &[entry("ruby", "1", Side::Both)]).extra,
+            ["ruby 1"]
+        );
+    }
+
+    #[test]
+    fn every_missing_mod_is_reported() {
+        let server: Vec<_> = (0..9)
+            .map(|i| entry(&format!("m{i}"), "1", Side::Both))
+            .collect();
+        assert_eq!(
+            compare(&server, &[]).missing,
+            [
+                "m0 1", "m1 1", "m2 1", "m3 1", "m4 1", "m5 1", "m6 1", "m7 1", "m8 1"
+            ]
+        );
+    }
+}
