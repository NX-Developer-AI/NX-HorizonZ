diff --git a/crates/horizon-protocol/examples/protocol_identifiers_probe.rs b/crates/horizon-protocol/examples/protocol_identifiers_probe.rs
new file mode 100644
index 0000000000..90a1719c91
--- /dev/null
+++ b/crates/horizon-protocol/examples/protocol_identifiers_probe.rs
@@ -0,0 +1,39 @@
+//! The packet identifier parity corpus, without a connection or game resources.
+use horizon_protocol::buf::{Codec, Ident, Reader};
+use std::{
+    error::Error,
+    fs::File,
+    io::{BufRead, BufReader, BufWriter, Write},
+};
+
+fn main() -> Result<(), Box<dyn Error>> {
+    let args: Vec<_> = std::env::args().collect();
+    let mut output = BufWriter::new(File::create(&args[2])?);
+    for line in BufReader::new(File::open(&args[1])?).lines() {
+        let hex = line?;
+        if hex.len() % 2 != 0 {
+            return Err("odd hex length".into());
+        }
+        let bytes = hex
+            .as_bytes()
+            .as_chunks::<2>()
+            .0
+            .iter()
+            .map(|pair| {
+                u8::from_str_radix(std::str::from_utf8(pair)?, 16).map_err(Box::<dyn Error>::from)
+            })
+            .collect::<Result<Vec<_>, Box<dyn Error>>>()?;
+        let mut reader = Reader::new(&bytes);
+        match Ident::read(&mut reader) {
+            Ok(value) => {
+                write!(output, "OK {} ", reader.position())?;
+                for unit in value.encode_utf16() {
+                    write!(output, "{unit:04x}")?;
+                }
+                writeln!(output)?;
+            }
+            Err(_) => writeln!(output, "ERR {}", reader.position())?,
+        }
+    }
+    Ok(())
+}
