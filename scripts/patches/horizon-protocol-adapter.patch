+        session.legacy_metadata.lock().unwrap().forget(42);
+        session.kinds.lock().unwrap().insert(42, 159);
+        let mut data = metadata(ServerVersion::V1_20_3, "2a0b0800ff");
+        entity_data(&session, &mut data);
