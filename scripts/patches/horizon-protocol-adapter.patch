+    w.varint(entries.len() as i32);
+    for entry in entries {
+        let data = entry
+            .get("entity_data")
+            .ok_or_else(|| Error::new("bee has no entity data"))?;
+        let Component::Raw(data) = typed_data(data, "minecraft:entity_type")? else {
+            unreachable!();
